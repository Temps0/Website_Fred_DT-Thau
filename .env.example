# Copy to .env and adapt. Never commit .env.
# docker compose reads this file. Locally, npm scripts do not: pass the variables on the
# command line, e.g. SITE_DOMAIN=dt-thau.fr npm run build, or DATA_DIR=./data npm start.

# Public domain of the site, without https:// (build time). Behind the reverse proxy,
# Astro only trusts this domain for the forwarded host, protocol and client IP.
SITE_DOMAIN=dt-thau.example

# "true" lets search engines index the site (build time). Keep "false" on a staging server
# and as long as legal or factual content is still marked "[À COMPLÉTER]".
SITE_INDEXABLE=false

# Directory of the SQLite database holding form submissions (read when the server
# starts). In the container it is the /app/data volume.
DATA_DIR=./data

# External Docker network shared with the Caddy reverse proxy (compose.yml).
PROXY_NETWORK=proxy
