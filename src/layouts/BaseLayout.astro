---
import '../styles/tokens.css';
import '../styles/base.css';
import { SITE_INDEXABLE } from 'astro:env/server';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { brand } from '../data/site';
import { organizationJsonLd } from '../lib/structured-data';
import { frenchSpacing } from '../lib/text';

interface Props {
  /** Page title, without the site name (omit on the home page). */
  title?: string;
  description: string;
  /** Keep this page out of search results even when the site is indexable (404, errors). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fullTitle = frenchSpacing(title ? `${title} | ${brand.name}` : brand.name);
const metaDescription = frenchSpacing(description);
// No canonical URL on pages never meant for search results (the 404 is served at any URL).
const canonicalUrl =
  Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const isIndexable = SITE_INDEXABLE && !noindex;
const isHome = Astro.url.pathname === '/';
// Share image: 1200 × 630, the name on deep green (public/og/). Absolute URL required.
const shareImage = Astro.site ? new URL('/og/dt-thau.png', Astro.site).href : undefined;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {!isIndexable && <meta name="robots" content="noindex, nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {
      shareImage && (
        <>
          <meta property="og:image" content={shareImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={`${brand.name} : formations à la transition écologique et à la RSE, Bassin de Thau`} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    {
      isHome && Astro.site && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(organizationJsonLd(Astro.site))}
        />
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#143d35" />
    <link
      rel="preload"
      href="/fonts/fraunces/fraunces-500-soft-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/atkinson-hyperlegible-next/atkinson-hyperlegible-next-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>

    <SiteHeader />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />

    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>

