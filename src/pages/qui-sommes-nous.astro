---
import CtaBand from '../components/CtaBand.astro';
import FounderPortrait from '../components/FounderPortrait.astro';
import PageHero from '../components/PageHero.astro';
import ToComplete from '../components/ToComplete.astro';
import { area, brand, company, contactNav, founder } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const values = [
  { title: 'Pédagogie', text: 'Rendre les sujets complexes accessibles, sans jargon.' },
  { title: 'Pragmatisme', text: 'Privilégier ce qui est utile et faisable pour votre structure.' },
  {
    title: 'Responsabilité',
    text: 'Agir avec exigence et honnêteté, sans culpabiliser ni promettre l’impossible.',
  },
];
---

<BaseLayout
  title="Qui sommes-nous ? L’origine du projet et son fondateur"
  description="DT-Thau, organisme de formation créé à Mèze en 2026 par Frédéric Dessombs, aide les acteurs du Bassin de Thau à passer à l’action écologique."
>
  <PageHero lines={['Qui sommes-nous ?']} titleId="about-title">
    <p class="lead">
      {brand.name} est née d’une conviction&nbsp;: rendre la transition écologique compréhensible
      et permettre aux acteurs du {area} de passer de la réflexion à l’action.
    </p>
  </PageHero>

  <section class="chapter chapter--sage" aria-labelledby="origin-title">
    <div class="container split" data-reveal>
      <h2 id="origin-title">L’origine du projet</h2>
      <p class="statement">
        <ToComplete>l’histoire du projet en quelques phrases&nbsp;: le déclic, le constat, l’envie</ToComplete>
      </p>
    </div>
  </section>

  <section class="chapter chapter--paper" aria-labelledby="founder-title">
    <div class="container founder" data-reveal>
      <FounderPortrait />
      <div class="flow flow--m">
        <h2 id="founder-title">Qui porte le projet</h2>
        <p class="lead">
          <strong>{founder.name}</strong><br />
          {founder.role}
        </p>
        <dl class="founder__facts">
          <div>
            <dt>Parcours</dt>
            <dd><ToComplete>expériences professionnelles marquantes</ToComplete></dd>
          </div>
          <div>
            <dt>Expertise</dt>
            <dd><ToComplete>compétences en transition écologique, RSE et formation</ToComplete></dd>
          </div>
          <div>
            <dt>Formations et certifications</dt>
            <dd><ToComplete>diplômes, certifications, références vérifiables</ToComplete></dd>
          </div>
        </dl>
        <p><a href={founder.linkedin}>Profil LinkedIn de {founder.name}</a></p>
      </div>
    </div>
  </section>

  <section class="chapter chapter--lagoon" aria-labelledby="values-title">
    <div class="container flow flow--l" data-reveal>
      <div class="split">
        <h2 id="values-title">Notre engagement</h2>
        <p class="lead">
          Une approche fondée sur trois valeurs, avec un ancrage particulier dans les réalités du
          {area}.
        </p>
      </div>
      {/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none */}
      <ul class="values" role="list" data-reveal>
        {
          values.map((value) => (
            <li>
              <h3 class="values__title">{value.title}</h3>
              <p>{value.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="chapter chapter--sand" aria-labelledby="facts-title">
    <div class="container split" data-reveal>
      <h2 id="facts-title">{brand.name} en bref</h2>
      {/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none */}
      <ul class="facts" role="list">
        <li>Organisme de formation et de conseil en développement durable et RSE</li>
        <li>Créée en 2026, basée à {company.address.city}</li>
        <li>
          Au service des entreprises, des établissements d’enseignement et des collectivités du
          {area}
        </li>
      </ul>
    </div>
  </section>

  <CtaBand
    href={contactNav.href}
    lines={['Faisons', 'connaissance']}
    sentence="Un échange de 30 minutes, en visio ou en présentiel."
  />
</BaseLayout>

<style>
  /* Heading on the left, what it introduces on the right. */
  .split {
    display: grid;
    gap: var(--space-m) var(--space-xl);
  }

  @media (min-width: 56rem) {
    .split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: baseline;
    }
  }

  .statement {
    font-size: var(--step-1);
  }

  .founder {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .founder {
      grid-template-columns: auto minmax(0, 40rem);
      justify-content: start;
      column-gap: clamp(3rem, 1rem + 6vw, 8rem);
    }
  }

  .founder__facts {
    display: grid;
    gap: var(--space-m);
  }

  .founder__facts dt {
    color: var(--color-heading);
    font-weight: var(--weight-semibold);
  }

  .founder__facts dd {
    margin: 0;
  }

  .values {
    display: grid;
    gap: var(--space-xl);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 56rem) {
    .values {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .values li > * + * {
    margin-block-start: var(--space-xs);
  }

  /* The subheading size keeps "Responsabilité" whole in a third of the width. */
  .values__title {
    color: var(--color-accent-text);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: var(--weight-medium);
    line-height: var(--leading-display);
  }

  .facts {
    display: grid;
    gap: var(--space-m);
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    line-height: 1.25;
  }
</style>
