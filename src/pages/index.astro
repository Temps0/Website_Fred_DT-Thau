---
import AudienceList from '../components/AudienceList.astro';
import CtaBand from '../components/CtaBand.astro';
import FounderPortrait from '../components/FounderPortrait.astro';
import LearningPath from '../components/LearningPath.astro';
import LinkButton from '../components/LinkButton.astro';
import PageHero from '../components/PageHero.astro';
import PrincipleList from '../components/PrincipleList.astro';
import ToComplete from '../components/ToComplete.astro';
import { area, contactNav, founder } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Formation transition écologique et RSE, Bassin de Thau"
  description="DT-Thau forme les entreprises, les écoles et les collectivités du Bassin de Thau à la transition écologique et à la RSE : formations courtes et concrètes."
>
  <PageHero lines={['Accélérer la', 'transition']} titleId="hero-title" size="xl">
    <p class="lead">
      Formations à la transition écologique et à la RSE pour les entreprises, les écoles et
      les collectivités du {area}.
    </p>
    <div class="actions">
      <LinkButton href={contactNav.href}>Réserver un échange de 30&nbsp;minutes</LinkButton>
      <LinkButton href="/programmes/" variant="secondary">Découvrir les programmes</LinkButton>
    </div>
  </PageHero>

  <section class="chapter chapter--paper" aria-labelledby="audience-title">
    <div class="container split" data-reveal>
      <div class="flow flow--m">
        <h2 id="audience-title">Pour qui&nbsp;?</h2>
        <p class="lead">
          Une expertise de la transition écologique et un ancrage local, au service de trois
          publics.
        </p>
      </div>
      <AudienceList />
    </div>
  </section>

  <section class="chapter chapter--sage" aria-labelledby="path-title">
    <div class="container" data-reveal>
      <LearningPath>
        <h2 id="path-title" slot="intro">Du constat à l’action</h2>
        <p class="lead" slot="intro">
          Trois modules de 3&nbsp;heures, au cœur du programme CAP TRANSITION Étudiants&nbsp;:
          décoder le dérèglement climatique, comprendre la RSE, puis mesurer son empreinte
          carbone pour agir.
        </p>
      </LearningPath>
      <p class="path-more">
        <a href="/programmes/#ecoles">Voir le détail des modules et les tarifs</a>
      </p>
    </div>
  </section>

  <section class="chapter chapter--lagoon" aria-labelledby="approach-title">
    <div class="container flow flow--l" data-reveal>
      <div class="approach-intro">
        <h2 id="approach-title">Notre approche</h2>
        <p class="lead">
          Une approche professionnalisante, ancrée dans les réalités du {area}, sans culpabiliser
          ni simplifier à l’excès.
        </p>
      </div>
      <PrincipleList />
      <p><a href="/approche/">Découvrir notre approche</a></p>
    </div>
  </section>

  <section class="chapter chapter--sand" aria-labelledby="founder-title">
    <div class="container founder" data-reveal>
      <div class="flow flow--m">
        <h2 id="founder-title">Qui porte le projet</h2>
        <p class="lead">
          <strong>{founder.name}</strong><br />
          {founder.role}
        </p>
        <p>
          <ToComplete>une ou deux phrases sur le parcours du fondateur</ToComplete>
        </p>
        <p><a href="/qui-sommes-nous/">Qui sommes-nous&nbsp;?</a></p>
      </div>
      <div class="founder__portrait">
        <FounderPortrait />
      </div>
    </div>
  </section>

  <CtaBand
    href={contactNav.href}
    word="Parlons"
    sentence="Réservez un échange de 30 minutes, en visio ou en présentiel, pour parler de votre situation."
  />
</BaseLayout>

<style>
  /* Heading and lead on the left, the content it introduces on the right. */
  .split {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 56rem) {
    .split {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      align-items: start;
    }
  }

  .path-more {
    margin-block-start: var(--space-xl);
  }

  .approach-intro {
    display: grid;
    gap: var(--space-m);
    margin-block-end: var(--space-xl);
  }

  @media (min-width: 56rem) {
    .approach-intro {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: baseline;
    }
  }

  .founder {
    display: grid;
    gap: var(--space-xl);
    align-items: end;
  }

  /* The portrait first, the text beside it: the two stay together on the grid. */
  @media (min-width: 48rem) {
    .founder {
      grid-template-columns: auto minmax(0, 40rem);
      justify-content: start;
      column-gap: clamp(3rem, 1rem + 6vw, 8rem);
    }

    .founder__portrait {
      grid-row: 1;
      grid-column: 1;
    }
  }

</style>
