---
import AudienceList from '../components/AudienceList.astro';
import CtaBand from '../components/CtaBand.astro';
import FormulaSimulator from '../components/FormulaSimulator.astro';
import Icon from '../components/Icon.astro';
import LearningPath from '../components/LearningPath.astro';
import LinkButton from '../components/LinkButton.astro';
import ModuleCard from '../components/ModuleCard.astro';
import ToComplete from '../components/ToComplete.astro';
import Waterline from '../components/Waterline.astro';
import { audiences, modalities } from '../data/audiences';
import { studentProgramme } from '../data/cap-transition-etudiants';
import { contactNav } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getModules } from '../lib/modules';
import { frenchSpacing } from '../lib/text';

const modules = await getModules();
const schools = audiences.find((audience) => audience.id === 'ecoles');
if (!schools) {
  throw new Error('Audience "ecoles" is missing from src/data/audiences.ts');
}
const otherAudiences = audiences.filter((audience) => audience.id !== 'ecoles');
// The promise follows the programme name after a colon: lower-case its first letter.
const studentPromise =
  studentProgramme.promise.charAt(0).toLowerCase() + studentProgramme.promise.slice(1);
const perStudentBasis = frenchSpacing(studentProgramme.perStudentBasis);
---

<BaseLayout
  title="Programmes CAP TRANSITION : écoles, PME, collectivités"
  description="Programmes CAP TRANSITION de DT-Thau : formations courtes et concrètes à la transition écologique pour écoles, TPE/PME et collectivités du Bassin de Thau."
>
  <Waterline lines={['CAP TRANSITION']} titleId="programmes-title" size="m">
    <p class="lead">
      Des formations courtes et concrètes pour comprendre les enjeux écologiques et leurs
      conséquences sur l’entreprise.
    </p>
    {/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none */}
    <ul class="modalities" role="list" aria-label="Modalités">
      {
        modalities.map((modality) => (
          <li>
            <Icon name={modality.icon} />
            {modality.label}
          </li>
        ))
      }
      <li>
        <Icon name="check" />
        <ToComplete>financement possible, selon la certification Qualiopi</ToComplete>
      </li>
    </ul>
  </Waterline>

  <section class="chapter chapter--paper" aria-labelledby="audiences-title">
    <div class="container split" data-reveal>
      <div class="flow flow--m">
        <h2 id="audiences-title">Pour qui&nbsp;?</h2>
        <p class="lead">Accompagner les acteurs locaux vers un modèle durable et responsable.</p>
      </div>
      <AudienceList />
    </div>
  </section>

  <section id="ecoles" class="chapter chapter--sage" aria-labelledby="ecoles-title">
    <div class="container programme">
      <header class="programme-intro" data-reveal>
        <div class="flow flow--m">
          <h2 id="ecoles-title">{schools.name}</h2>
          <p class="lead">{frenchSpacing(`${studentProgramme.name} : ${studentPromise}`)}</p>
          {/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none */}
          <ul class="checklist" role="list">
            {
              studentProgramme.highlights.map((item) => (
                <li>
                  <Icon name="check" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <blockquote class="quote">
          <p>{frenchSpacing(studentProgramme.quote)}</p>
        </blockquote>
      </header>

      <section aria-labelledby="path-title">
        <LearningPath linkToModules>
          <h3 id="path-title" class="subtitle" slot="intro">Le parcours</h3>
          <p slot="intro">
            Décoder, comprendre, puis agir&nbsp;: les trois étapes du parcours complet.
            Choisissez une étape pour lire le détail de son module.
          </p>
        </LearningPath>
      </section>

      <section class="flow flow--l" aria-labelledby="modules-title">
        <h3 id="modules-title" class="subtitle">Les 3 modules de 3&nbsp;heures</h3>
        <div class="modules" data-reveal>
          {modules.map((module) => <ModuleCard module={module} as="h4" />)}
        </div>
      </section>
    </div>
  </section>

  <section id="tarifs" class="chapter chapter--lagoon" aria-labelledby="offers-title">
    <div class="container flow flow--l">
      <div class="offers-intro" data-reveal>
        <h2 id="offers-title">Formules et tarifs</h2>
        <p class="lead">{frenchSpacing(studentProgramme.conditions)}</p>
      </div>

      <FormulaSimulator />

      <div class="flow flow--m" data-reveal>
        <p class="per-student">
          <strong>{studentProgramme.perStudent}</strong> ({perStudentBasis})
        </p>
        {/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none */}
        <ul class="checklist checklist--inline" role="list">
          {
            studentProgramme.included.map((item) => (
              <li>
                <Icon name="check" />
                {item}
              </li>
            ))
          }
          <li>
            <Icon name="check" />
            <ToComplete>attestation de participation ou de formation</ToComplete>
          </li>
        </ul>
      </div>

      <aside class="custom-offer" aria-label="Offre sur mesure" data-reveal>
        <p class="custom-offer__question">{frenchSpacing(studentProgramme.custom.question)}</p>
        <p>{frenchSpacing(studentProgramme.custom.answer)}</p>
        <div class="actions">
          <LinkButton href={contactNav.href}>Réserver un échange de 30&nbsp;minutes</LinkButton>
        </div>
      </aside>
    </div>
  </section>

  <section class="chapter chapter--paper" aria-label="Autres programmes">
    <div class="container others" data-reveal>
      {
        otherAudiences.map((audience) => (
          <section
            id={audience.id}
            class="flow flow--m"
            aria-labelledby={`${audience.id}-title`}
          >
            <h2 id={`${audience.id}-title`}>{audience.name}</h2>
            <p class="lead">{frenchSpacing(audience.summary)}</p>
            <p>Contenu et tarifs sur devis, selon vos enjeux et votre organisation.</p>
            <div class="actions">
              <LinkButton href={contactNav.href}>Échanger sur votre besoin</LinkButton>
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <CtaBand
    href={contactNav.href}
    word="Parlons"
    sentence="Vous vous demandez par où commencer ? Échangeons sur votre situation, en visio ou en présentiel."
  />
</BaseLayout>

<style>
  .modalities {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs) var(--space-l);
    padding: 0;
    list-style: none;
  }

  .modalities li,
  .checklist li {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .split {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 56rem) {
    .split {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      align-items: start;
    }
  }

  /* The intro, the path and the modules: a chapter-sized gap between each. */
  .programme > * + * {
    margin-block-start: var(--space-chapter);
  }

  .subtitle {
    font-size: var(--step-4);
  }

  .programme-intro {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .programme-intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-2xl);
    }
  }

  .checklist {
    display: grid;
    gap: var(--space-2xs);
    padding: 0;
    list-style: none;
  }

  .checklist--inline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-l);
  }

  /* The deck's quote, as a statement set in the title serif. */
  .quote {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-display);
    /* A statement: three lines on desktop, four on a phone. */
    font-size: clamp(1.25rem, 0.9rem + 1.2vw, 1.75rem);
    font-weight: var(--weight-medium);
    line-height: 1.25;
  }

  .modules {
    display: grid;
    gap: var(--space-l);
  }

  .offers-intro {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 56rem) {
    .offers-intro {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: baseline;
    }
  }

  .per-student {
    font-size: var(--step-1);
  }

  .custom-offer {
    display: grid;
    gap: var(--space-s);
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    background-color: var(--green-deep-raised);
  }

  .custom-offer__question {
    color: var(--color-heading);
    font-size: var(--step-2);
    font-weight: var(--weight-bold);
  }

  .others {
    display: grid;
    gap: var(--space-chapter);
  }

  @media (min-width: 56rem) {
    .others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-2xl);
    }
  }
</style>
