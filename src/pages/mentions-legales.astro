---
import ToComplete from '../components/ToComplete.astro';
import { company } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mentions légales"
  description="Mentions légales du site de DT-Thau : éditeur, organisme de formation, hébergement et propriété intellectuelle."
>
  <div class="container section">
    <article class="prose">
      <h1>Mentions légales</h1>

      <h2>Éditeur du site</h2>
      <p>
        <strong>{company.name}</strong>, {company.legalForm} au capital de {company.capital}<br />
        Siège social&nbsp;: {company.address.street}, {company.address.postalCode}
        {company.address.city}<br />
        Immatriculation&nbsp;: {company.registration}<br />
        EUID&nbsp;: {company.euid}<br />
        TVA intracommunautaire&nbsp;:
        {company.vatNumber ?? <ToComplete>numéro de TVA intracommunautaire</ToComplete>}
      </p>
      <p>
        Téléphone&nbsp;: {company.phone ?? <ToComplete>téléphone</ToComplete>}<br />
        E-mail&nbsp;: {company.email ?? <ToComplete>adresse e-mail</ToComplete>}
      </p>
      <p>
        Directeur de la publication&nbsp;:
        {company.publicationDirector ?? <ToComplete>nom du directeur de la publication</ToComplete>}
      </p>

      <h2>Organisme de formation</h2>
      <p>
        Enregistré sous le numéro
        {
          company.trainingDeclarationNumber ?? (
            <ToComplete>numéro de déclaration d’activité</ToComplete>
          )
        } auprès du préfet de région Occitanie. Cet enregistrement ne vaut pas agrément de l’État.
      </p>

      <h2>Hébergement</h2>
      <p>
        <ToComplete>nom ou raison sociale, adresse et téléphone de l’hébergeur</ToComplete>
      </p>

      <h2>Propriété intellectuelle</h2>
      <p>
        Les contenus de ce site (textes, images, logo) appartiennent à {company.name} ou sont
        utilisés avec l’autorisation de leurs auteurs. Leur reproduction sans autorisation est
        interdite.
      </p>
      <p>Crédits photographiques&nbsp;: <ToComplete>auteurs et sources des photos, dont l’auteur du portrait du fondateur et son accord</ToComplete></p>
      <p>
        Pictogrammes&nbsp;: <a href="https://lucide.dev">Lucide</a>, © Lucide Icons and
        Contributors, sous <a href="https://lucide.dev/license">licence ISC</a>&nbsp;; certains
        dérivent de <a href="https://feathericons.com">Feather</a>, © Cole Bemis, sous
        <a href="https://github.com/feathericons/feather/blob/main/LICENSE">licence MIT</a>.
      </p>
      <p>
        Police des titres&nbsp;: <a href="https://github.com/undercasetype/Fraunces">Fraunces</a>,
        © The Fraunces Project Authors, sous
        <a href="/fonts/fraunces/OFL.txt">SIL Open Font License 1.1</a>.
      </p>

      <h2>Données personnelles</h2>
      <p>
        Le traitement de vos données est décrit dans la
        <a href="/confidentialite/">politique de confidentialité</a>.
      </p>
    </article>
  </div>
</BaseLayout>
