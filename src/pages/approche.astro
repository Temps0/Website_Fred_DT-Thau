---
import CtaBand from '../components/CtaBand.astro';
import LinkButton from '../components/LinkButton.astro';
import PageHero from '../components/PageHero.astro';
import PrincipleList from '../components/PrincipleList.astro';
import { photos } from '../data/photos';
import { area, contactNav } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Notre approche : accessible, concrète, locale, flexible"
  description="Une approche professionnalisante de la transition écologique : accessible, concrète, ancrée dans le Bassin de Thau et adaptée à chaque public."
>
  <PageHero
    lines={['Une approche', 'professionnalisante']}
    titleId="approach-title"
    size="m"
    photo={photos.strategyWorkshop}
  >
    <p class="lead">
      Une expertise de la transition écologique et un ancrage local dans le {area}&nbsp;: quatre
      principes guident chacune de nos formations.
    </p>
  </PageHero>

  <section class="chapter chapter--paper" aria-label="Nos quatre principes">
    <div class="container flow flow--l" data-reveal>
      <PrincipleList as="h2" layout="rows" />
    </div>
  </section>

  <section class="chapter chapter--sage" aria-labelledby="practice-title">
    <div class="container next" data-reveal>
      <h2 id="practice-title">Ces principes, en pratique</h2>
      <p class="lead">
        Des modules courts, des exercices et des cas d’entreprise&nbsp;: découvrez les
        programmes proposés aux écoles, aux entreprises et aux collectivités.
      </p>
      <div class="actions">
        <LinkButton href="/programmes/">Découvrir les programmes</LinkButton>
      </div>
    </div>
  </section>

  <CtaBand
    href={contactNav.href}
    lines={['Et chez', 'vous ?']}
    sentence="Un échange de 30 minutes, en visio ou en présentiel, pour en parler."
  />
</BaseLayout>

<style>
  .next {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 56rem) {
    .next {
      grid-template-columns: minmax(0, 5fr) minmax(0, 5fr) auto;
      align-items: baseline;
      column-gap: var(--space-xl);
    }
  }
</style>
