---
import FormErrorSummary from '../components/FormErrorSummary.astro';
import FormNotice from '../components/FormNotice.astro';
import Icon from '../components/Icon.astro';
import LinkButton from '../components/LinkButton.astro';
import PageHero from '../components/PageHero.astro';
import SpamTrap from '../components/SpamTrap.astro';
import TextField from '../components/TextField.astro';
import ToComplete from '../components/ToComplete.astro';
import { area, brand, company, founder, phoneHref, surveyNav } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { type ContactValues, handleContactPost } from '../lib/server/contact';

// Rendered on each request: the page receives the form post and shows its outcome.
export const prerender = false;

const outcome =
  Astro.request.method === 'POST'
    ? await handleContactPost(Astro.request, Astro.clientAddress)
    : undefined;

// Post/Redirect/Get: reloading the confirmation page does not send the message twice.
// No #fragment in the URLs: browsers skip autofocus when the URL targets an element.
if (outcome?.status === 'sent') return Astro.redirect('/contact/?envoye=1', 303);

const isSent = Astro.url.searchParams.has('envoye');
const values: Partial<ContactValues> = outcome && 'values' in outcome ? outcome.values : {};
const errors = outcome?.status === 'invalid' ? outcome.errors : {};

const fieldIds: Record<keyof ContactValues, string> = {
  name: 'contact-name',
  company: 'contact-company',
  email: 'contact-email',
  phone: 'contact-phone',
  message: 'contact-message',
};
const errorList = (Object.keys(fieldIds) as (keyof ContactValues)[])
  .filter((field) => errors[field])
  .map((field) => ({ fieldId: fieldIds[field], message: errors[field] as string }));

if (outcome?.status === 'invalid' || outcome?.status === 'too-fast') Astro.response.status = 422;
if (outcome?.status === 'rate-limited') Astro.response.status = 429;
if (outcome?.status === 'failed') Astro.response.status = 500;
if (outcome?.status === 'unreadable') Astro.response.status = 400;

// Any outcome left here is a failure: a successful post was redirected above.
const hasError = outcome !== undefined;
const titlePrefix = hasError ? 'Erreur : ' : isSent ? 'Message envoyé : ' : '';
---

<BaseLayout
  title={`${titlePrefix}Contact : échangeons sur votre projet`}
  description="Une question, un besoin de formation ? Réservez un échange de 30 minutes avec DT-Thau, organisme de formation à Mèze, au service du Bassin de Thau."
>
  {/* A shorter first screen: the form, the point of the page, starts close to the top. */}
  <PageHero lines={['Échangeons sur', 'votre projet']} titleId="contact-title" compact>
    <p class="lead">
      Réservez un échange de 30&nbsp;minutes, en visio ou en présentiel&nbsp;: écrivez-nous vos
      besoins et vos disponibilités, nous vous recontactons pour fixer le rendez-vous.
    </p>
    {
      !isSent && !hasError && (
        <div class="actions">
          <LinkButton href="#form-title">Écrire votre message</LinkButton>
        </div>
      )
    }
  </PageHero>

  <div class="chapter chapter--paper">
    <div class="container contact-grid">
      <section aria-labelledby="form-title" class="flow flow--m">
        <h2 id="form-title" class="contact-subtitle">Votre message</h2>

        {
          isSent && (
            <FormNotice tone="success" title="Merci, votre message a bien été envoyé.">
              <p>
                Nous vous répondons sous <ToComplete>délai de réponse</ToComplete>.
              </p>
            </FormNotice>
          )
        }
        {
          outcome?.status === 'too-fast' && (
            <FormNotice tone="error" title="Votre message n’a pas encore été envoyé.">
              <p>
                Pour nous protéger des envois automatiques, patientez quelques secondes puis
                envoyez de nouveau le formulaire&nbsp;: votre saisie a été conservée.
              </p>
            </FormNotice>
          )
        }
        {
          outcome?.status === 'rate-limited' && (
            <FormNotice tone="error" title="Votre message n’a pas été envoyé.">
              <p>
                {outcome.limit === 'client'
                  ? 'Plusieurs messages viennent d’être envoyés depuis votre connexion. Réessayez dans une dizaine de minutes.'
                  : 'Le formulaire reçoit beaucoup de messages en ce moment. Réessayez dans une heure.'}
              </p>
            </FormNotice>
          )
        }
        {
          (outcome?.status === 'failed' || outcome?.status === 'unreadable') && (
            <FormNotice tone="error" title="Votre message n’a pas pu être enregistré.">
              <p>Un problème technique est survenu de notre côté. Réessayez un peu plus tard.</p>
            </FormNotice>
          )
        }
        <FormErrorSummary errors={errorList} />

        <p id="form-hint">Tous les champs sont obligatoires, sauf mention «&nbsp;facultatif&nbsp;».</p>

        <form
          class="form"
          method="post"
          action="/contact/"
          aria-describedby="form-hint"
          novalidate
          data-submit-once
        >
          <TextField
            id={fieldIds.name}
            name="name"
            label="Nom"
            autocomplete="name"
            maxlength={120}
            required
            value={values.name}
            error={errors.name}
          />
          <TextField
            id={fieldIds.company}
            name="company"
            label="Structure"
            hint="Entreprise, établissement ou collectivité."
            autocomplete="organization"
            maxlength={160}
            required
            value={values.company}
            error={errors.company}
          />
          <TextField
            id={fieldIds.email}
            name="email"
            label="E-mail"
            type="email"
            autocomplete="email"
            maxlength={254}
            required
            value={values.email}
            error={errors.email}
          />
          <TextField
            id={fieldIds.phone}
            name="phone"
            label="Téléphone (facultatif)"
            hint="Si vous préférez être rappelé."
            type="tel"
            autocomplete="tel"
            maxlength={30}
            size="short"
            value={values.phone}
            error={errors.phone}
          />
          <TextField
            id={fieldIds.message}
            name="message"
            label="Message"
            hint="Votre situation, vos questions, vos disponibilités pour un échange."
            multiline
            maxlength={5000}
            required
            value={values.message}
            error={errors.message}
          />
          <SpamTrap
            formId="contact"
            startedAt={outcome?.status === 'invalid' ? outcome.startedAt : undefined}
          />

          <p class="form__privacy">
            {company.name}, responsable du traitement, utilise vos données uniquement pour répondre
            à votre demande (intérêt légitime)&nbsp;; elles ne sont jamais cédées. Elles sont
            conservées <ToComplete>durée de conservation</ToComplete>.
            <a href="/confidentialite/">En savoir plus sur vos données et vos droits</a>.
          </p>

          <div class="flow">
            <button type="submit" class="button button--primary">Envoyer ma demande</button>
            <p>Nous vous répondons sous <ToComplete>délai de réponse</ToComplete>.</p>
          </div>
        </form>

      </section>

      <aside class="contact-aside flow flow--l" aria-label="Coordonnées et questionnaire" data-reveal>
        <section aria-labelledby="details-title" class="contact-tile flow">
          <h2 id="details-title" class="contact-subtitle">Coordonnées</h2>
          <address class="flow">
            <p>
              <strong>{founder.name}</strong><br />
              {founder.role}
            </p>
            {/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none */}
            <ul class="contact-details" role="list">
              <li>
                <Icon name="phone" />
                <span>
                  Téléphone&nbsp;:
                  {
                    company.phone ? (
                      <a href={phoneHref(company.phone)}>{company.phone}</a>
                    ) : (
                      <ToComplete>téléphone</ToComplete>
                    )
                  }
                </span>
              </li>
              <li>
                <Icon name="mail" />
                <span>
                  E-mail&nbsp;:
                  {
                    company.email ? (
                      <a href={`mailto:${company.email}`}>{company.email}</a>
                    ) : (
                      <ToComplete>adresse e-mail</ToComplete>
                    )
                  }
                </span>
              </li>
              <li>
                <Icon name="map-pin" />
                <span>
                  {brand.name}<br />
                  {company.address.street}<br />
                  {company.address.postalCode} {company.address.city}
                </span>
              </li>
            </ul>
            <p><a href={founder.linkedin}>Profil LinkedIn de {founder.name}</a></p>
          </address>
          <p>
            Nous intervenons auprès des entreprises, des établissements d’enseignement et des
            collectivités du {area}.
          </p>
        </section>

        <section aria-labelledby="survey-title" class="survey-teaser flow">
          <h2 id="survey-title" class="contact-subtitle">Entreprise du {area}&nbsp;?</h2>
          <p>Aidez-nous à mieux connaître vos besoins en répondant à notre questionnaire.</p>
          <LinkButton href={surveyNav.href} variant="secondary">Répondre au questionnaire</LinkButton>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/submit-once';
</script>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 56rem) {
    .contact-grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: start;
    }
  }

  .contact-subtitle {
    font-size: var(--step-3);
  }

  .form {
    display: grid;
    gap: var(--space-m);
    max-width: 40rem;
  }

  .form__privacy {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  address {
    font-style: normal;
  }

  .contact-details {
    display: grid;
    gap: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .contact-details li {
    display: flex;
    gap: var(--space-xs);
    align-items: flex-start;
  }

  /* The details and the survey on colour tiles, one tone step from the page. */
  .contact-tile,
  .survey-teaser {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .contact-tile {
    background-color: var(--sage);
    --color-accent-text: var(--green-forest);
  }

  .survey-teaser {
    --button-secondary-bg: var(--cream);
    background-color: var(--cream-strong);
  }
</style>
