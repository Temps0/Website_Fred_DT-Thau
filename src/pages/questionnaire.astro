---
import { getEntry } from 'astro:content';
import ContentText from '../components/ContentText.astro';
import SurveyQuestion from '../components/SurveyQuestion.astro';
import WireNote from '../components/WireNote.astro';
import { company } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { frenchSpacing } from '../lib/text';

const survey = await getEntry('surveys', 'besoins-entreprises');
if (!survey) {
  throw new Error('Survey "besoins-entreprises" is missing from src/content/surveys.json');
}
const { title, intro, duration, sections } = survey.data;
---

<BaseLayout
  title="Questionnaire : vos besoins en transition écologique"
  description="Entreprise du Bassin de Thau ? Répondez à notre questionnaire sur vos besoins de formation à la transition écologique et à la RSE, sans indiquer votre nom ni celui de votre entreprise."
>
  <div class="container container--narrow section flow flow--l">
    <header class="flow flow--m">
      <p class="eyebrow">Questionnaire entreprises</p>
      <h1>{frenchSpacing(title)}</h1>
      <p class="lead">{frenchSpacing(intro)}</p>
      <p>Durée&nbsp;: <ContentText value={duration} /></p>
      <p>
        Le questionnaire ne demande ni votre nom ni celui de votre entreprise. Les questions
        marquées «&nbsp;obligatoire&nbsp;» doivent être remplies.
      </p>
      <WireNote>
        Questions d’exemple, à remplacer par celles du fondateur. Elles sont définies dans
        <code>src/content/surveys.json</code>&nbsp;: les modifier ne demande aucun développement.
      </WireNote>
    </header>

    <form class="survey flow flow--l" method="post">
      {
        sections.map((section, sectionIndex) => (
          <section class="survey__section" aria-labelledby={`survey-section-${sectionIndex}`}>
            <h2 id={`survey-section-${sectionIndex}`} class="survey__section-title">
              {frenchSpacing(section.title)}
            </h2>
            {section.questions.map((question) => (
              <SurveyQuestion question={question} />
            ))}
          </section>
        ))
      }

      <section class="survey__section" aria-labelledby="survey-contact-title">
        <h2 id="survey-contact-title" class="survey__section-title">
          Souhaitez-vous être recontacté&nbsp;? (facultatif)
        </h2>
        <p>
          Laissez votre adresse e-mail si vous souhaitez que {company.name} vous recontacte au sujet
          de vos réponses. Sans cela, vos réponses ne sont rattachées ni à votre nom ni à vos coordonnées.
        </p>
        <div class="field">
          <label for="survey-email">Votre adresse e-mail (facultatif)</label>
          <input id="survey-email" name="email" type="email" autocomplete="email" />
        </div>
        <label class="consent" for="survey-consent">
          <input id="survey-consent" name="contactConsent" type="checkbox" value="yes" />
          J’accepte que {company.name} utilise cette adresse pour me recontacter au sujet de mes
          réponses. Je peux retirer mon accord à tout moment.
        </label>
        <WireNote>
          Consentement explicite, case non cochée par défaut (RGPD). Côté serveur, l’adresse ne sera
          enregistrée que si la case est cochée.
        </WireNote>
      </section>

      <p class="survey__privacy">
        Vos réponses servent uniquement à adapter l’offre de formation de {company.name}.
        <a href="/confidentialite/">En savoir plus sur vos données et vos droits</a>.
      </p>

      <div class="flow">
        <button type="submit" class="button button--primary" disabled>Envoyer mes réponses</button>
        <WireNote>
          L’enregistrement des réponses (base SQLite, export CSV) sera branché à l’étape
          suivante&nbsp;: le bouton est désactivé dans le wireframe.
        </WireNote>
      </div>
    </form>
  </div>
</BaseLayout>

<style>
  .survey__section {
    display: grid;
    gap: var(--space-m);
    padding-block-start: var(--space-l);
    border-block-start: var(--border-width) solid var(--color-border-subtle);
  }

  .survey__section-title {
    font-size: var(--step-2);
  }

  .field {
    display: grid;
    gap: var(--space-3xs);
  }

  .field label {
    font-weight: var(--weight-semibold);
  }

  .field input {
    width: 100%;
    max-width: 28rem;
    min-height: 2.75rem;
    padding: var(--space-2xs) var(--space-xs);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-s);
    background-color: var(--color-bg);
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    cursor: pointer;
  }

  .consent input {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-block-start: 0.2em;
    accent-color: var(--color-primary);
  }

  .survey__privacy {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
</style>
