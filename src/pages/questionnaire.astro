---
import { getEntry } from 'astro:content';
import ContentText from '../components/ContentText.astro';
import FormErrorSummary from '../components/FormErrorSummary.astro';
import FormNotice from '../components/FormNotice.astro';
import SpamTrap from '../components/SpamTrap.astro';
import SurveyQuestion from '../components/SurveyQuestion.astro';
import TextField from '../components/TextField.astro';
import { area, brand } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { handleSurveyPost, type SurveyValues } from '../lib/server/survey-response';
import { questionAnchorId, SURVEY_CONSENT_FIELD, SURVEY_EMAIL_FIELD } from '../lib/survey';
import { frenchSpacing } from '../lib/text';

// Rendered on each request: the page receives the form post and shows its outcome.
export const prerender = false;

const SURVEY_ID = 'besoins-entreprises';
const survey = await getEntry('surveys', SURVEY_ID);
if (!survey) {
  throw new Error(`Survey "${SURVEY_ID}" is missing from src/content/surveys.json`);
}
const { title, intro, duration, sections } = survey.data;
const questions = sections.flatMap((section) => section.questions);

const outcome =
  Astro.request.method === 'POST'
    ? await handleSurveyPost(Astro.request, Astro.clientAddress, { id: SURVEY_ID, questions })
    : undefined;

// Post/Redirect/Get, without #fragment so that autofocus applies on the next page.
if (outcome?.status === 'sent') return Astro.redirect('/questionnaire/?merci=1', 303);

const isSent = Astro.url.searchParams.has('merci');
const values: Partial<SurveyValues> = outcome && 'values' in outcome ? outcome.values : {};
const errors = outcome?.status === 'invalid' ? outcome.errors : {};

const emailFieldId = 'survey-email';
const consentFieldId = 'survey-consent';
const errorList = [
  ...questions
    .filter((question) => errors[question.id])
    .map((question) => ({
      fieldId: questionAnchorId(question),
      message: `${frenchSpacing(question.label)} ${errors[question.id]}`,
    })),
  ...(errors[SURVEY_EMAIL_FIELD]
    ? [{ fieldId: emailFieldId, message: errors[SURVEY_EMAIL_FIELD] }]
    : []),
  ...(errors[SURVEY_CONSENT_FIELD]
    ? [{ fieldId: consentFieldId, message: errors[SURVEY_CONSENT_FIELD] }]
    : []),
];

if (outcome?.status === 'invalid' || outcome?.status === 'too-fast') Astro.response.status = 422;
if (outcome?.status === 'rate-limited') Astro.response.status = 429;
if (outcome?.status === 'failed') Astro.response.status = 500;
if (outcome?.status === 'unreadable') Astro.response.status = 400;

// Any outcome left here is a failure: a successful post was redirected above.
const titlePrefix = outcome !== undefined ? 'Erreur : ' : isSent ? 'Merci : ' : '';
const consentErrorId = errors[SURVEY_CONSENT_FIELD] ? `${consentFieldId}__error` : undefined;
---

<BaseLayout
  title={`${titlePrefix}Questionnaire : vos besoins en transition écologique`}
  description="Entreprise du Bassin de Thau ? Répondez à notre questionnaire sur vos besoins de formation à la transition écologique et à la RSE, sans indiquer votre nom ni celui de votre entreprise."
>
  <div class="container container--narrow section flow flow--l">
    <header class="flow flow--m">
      <h1>{frenchSpacing(title)}</h1>
      {
        !isSent && (
          <>
            <p class="lead">{frenchSpacing(intro)}</p>
            <p>
              Durée&nbsp;: <ContentText value={duration} />
            </p>
            <p>
              Le questionnaire ne demande ni votre nom ni celui de votre entreprise. Les
              questions marquées «&nbsp;obligatoire&nbsp;» doivent être remplies.
            </p>
          </>
        )
      }
    </header>

    {
      isSent ? (
        <FormNotice tone="success" title={`Merci pour vos réponses\u00a0!`}>
          <p>
            Elles nous aident à construire des formations utiles aux entreprises du {area}.
          </p>
          <p>
            <a href="/">Retour à l’accueil</a>
          </p>
        </FormNotice>
      ) : (
        <>
          {outcome?.status === 'too-fast' && (
            <FormNotice tone="error" title="Vos réponses n’ont pas encore été envoyées.">
              <p>
                Pour nous protéger des envois automatiques, patientez quelques secondes puis
                envoyez de nouveau le questionnaire&nbsp;: vos réponses ont été conservées.
              </p>
            </FormNotice>
          )}
          {outcome?.status === 'rate-limited' && (
            <FormNotice tone="error" title="Vos réponses n’ont pas été envoyées.">
              <p>
                {outcome.limit === 'client'
                  ? 'Plusieurs questionnaires viennent d’être envoyés depuis votre connexion. Réessayez dans une dizaine de minutes.'
                  : 'Le questionnaire reçoit beaucoup de réponses en ce moment. Réessayez dans une heure.'}
              </p>
            </FormNotice>
          )}
          {(outcome?.status === 'failed' || outcome?.status === 'unreadable') && (
            <FormNotice tone="error" title="Vos réponses n’ont pas pu être enregistrées.">
              <p>Un problème technique est survenu de notre côté. Réessayez un peu plus tard.</p>
            </FormNotice>
          )}
          <FormErrorSummary errors={errorList} />

          <form class="survey flow flow--l" method="post" action="/questionnaire/">
            {sections.map((section, sectionIndex) => (
              <section class="survey__section" aria-labelledby={`survey-section-${sectionIndex}`}>
                <h2 id={`survey-section-${sectionIndex}`} class="survey__section-title">
                  {frenchSpacing(section.title)}
                </h2>
                {section.questions.map((question) => (
                  <SurveyQuestion
                    question={question}
                    value={values.answers?.[question.id]}
                    error={errors[question.id]}
                  />
                ))}
              </section>
            ))}

            <section class="survey__section" aria-labelledby="survey-contact-title">
              <h2 id="survey-contact-title" class="survey__section-title">
                Souhaitez-vous être recontacté&nbsp;? (facultatif)
              </h2>
              <p>
                Laissez votre adresse e-mail si vous souhaitez que {brand.name} vous recontacte
                au sujet de vos réponses. Sans cela, vos réponses ne sont rattachées ni à votre nom
                ni à vos coordonnées.
              </p>
              <TextField
                id={emailFieldId}
                name={SURVEY_EMAIL_FIELD}
                label="Votre adresse e-mail (facultatif)"
                type="email"
                autocomplete="email"
                maxlength={254}
                value={values.email}
                error={errors[SURVEY_EMAIL_FIELD]}
              />
              <div class:list={['consent', { 'consent--invalid': consentErrorId }]}>
                {consentErrorId && (
                  <p class="consent__error" id={consentErrorId}>
                    <span class="visually-hidden">Erreur&nbsp;:</span>
                    {errors[SURVEY_CONSENT_FIELD]}
                  </p>
                )}
                <label class="consent__label" for={consentFieldId}>
                  <input
                    id={consentFieldId}
                    name={SURVEY_CONSENT_FIELD}
                    type="checkbox"
                    value="yes"
                    checked={values.contactConsent}
                    aria-describedby={consentErrorId}
                    aria-invalid={consentErrorId ? 'true' : undefined}
                  />
                  J’accepte que {brand.name} utilise cette adresse pour me recontacter au sujet
                  de mes réponses. Je peux retirer mon accord à tout moment.
                </label>
              </div>
            </section>

            <SpamTrap
              formId="survey"
              startedAt={outcome?.status === 'invalid' ? outcome.startedAt : undefined}
            />

            <p class="survey__privacy">
              Vos réponses servent uniquement à adapter l’offre de formation de {brand.name}.
              <a href="/confidentialite/">En savoir plus sur vos données et vos droits</a>.
            </p>

            <div>
              <button type="submit" class="button button--primary">Envoyer mes réponses</button>
            </div>
          </form>
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .survey__section {
    display: grid;
    gap: var(--space-m);
    padding-block-start: var(--space-l);
    border-block-start: var(--border-width) solid var(--color-border-subtle);
  }

  .survey__section-title {
    font-size: var(--step-2);
  }

  .consent {
    display: grid;
    gap: var(--space-2xs);
  }

  .consent--invalid {
    padding-inline-start: var(--space-s);
    border-inline-start: 4px solid var(--color-danger);
  }

  .consent__error {
    color: var(--color-danger);
    font-weight: var(--weight-semibold);
  }

  .consent__label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    cursor: pointer;
  }

  .consent__label input {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-block-start: 0.2em;
    accent-color: var(--color-primary);
  }

  .survey__privacy {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
</style>
