---
/**
 * One module of the programme as a full-width sheet, one tone step lighter than the sage
 * chapter it sits on: the module named on the left, its objective and topics in the
 * middle, the skill acquired and the Qualiopi details on the right.
 */
import type { CollectionEntry } from 'astro:content';
import { frenchSpacing } from '../lib/text';
import ContentText from './ContentText.astro';

interface Props {
  module: CollectionEntry<'modules'>;
  /** Heading level of the module title, to fit the page outline. */
  as?: 'h3' | 'h4';
}

const { module, as: Heading = 'h3' } = Astro.props;
const { data } = module;
const titleId = `module-${module.id}`;

const details = [
  { term: 'Prérequis', value: data.prerequisites },
  { term: 'Modalités et délais d’accès', value: data.access },
  { term: 'Tarif', value: data.price },
  { term: 'Méthodes pédagogiques', value: data.methods },
  { term: 'Évaluation', value: data.assessment },
  { term: 'Accessibilité', value: data.accessibility },
].filter((item): item is { term: string; value: string } => Boolean(item.value));
---

<article class="module" id={module.id} aria-labelledby={titleId}>
  <header class="module__header">
    <Heading id={titleId} class="module__title">{frenchSpacing(data.title)}</Heading>
    <p class="module__tagline">{frenchSpacing(data.tagline)}</p>
    <p class="module__theme">
      {data.theme} · {data.verb} · {frenchSpacing(data.duration)}
    </p>
  </header>

  <div class="module__body">
    <div class="module__block">
      <p class="module__label">Objectif</p>
      <p>{frenchSpacing(data.objective)}</p>
    </div>
    <div class="module__block">
      <p class="module__label">Au programme</p>
      <ul class="module__topics">
        {data.topics.map((topic) => <li>{frenchSpacing(topic)}</li>)}
      </ul>
    </div>
  </div>

  <div class="module__aside">
    <div class="module__skill">
      <p class="module__label">Compétence acquise</p>
      <p>{frenchSpacing(data.skill)}</p>
    </div>
    {
      details.length > 0 && (
        <details class="module__details">
          <summary>Prérequis, méthodes et évaluation</summary>
          <dl>
            {details.map((item) => (
              <div>
                <dt>{item.term}</dt>
                <dd>
                  <ContentText value={item.value} />
                </dd>
              </div>
            ))}
          </dl>
        </details>
      )
    }
  </div>
</article>

<style>
  .module {
    display: grid;
    gap: var(--space-l);
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    background-color: var(--cream);
  }

  @media (min-width: 64rem) {
    .module {
      grid-template-columns: minmax(0, 4fr) minmax(0, 4fr) minmax(0, 4fr);
      column-gap: var(--space-xl);
    }
  }

  .module__header {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
  }

  /* One step under the section titles (h2) of the page. */
  .module__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: var(--weight-medium);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .module__tagline {
    color: var(--color-accent-text);
    font-size: var(--step-1);
  }

  .module__theme {
    color: var(--color-text-muted);
  }

  .module__body,
  .module__aside {
    display: grid;
    align-content: start;
    gap: var(--space-m);
  }

  .module__label {
    color: var(--color-heading);
    font-weight: var(--weight-bold);
  }

  .module__block > * + *,
  .module__skill > * + * {
    margin-block-start: var(--space-3xs);
  }

  .module__topics {
    padding-inline-start: var(--space-m);
  }

  .module__topics li::marker {
    color: var(--color-accent);
  }

  /* The charter's sage box for acquired skills. */
  .module__skill {
    padding: var(--space-m);
    background-color: var(--sage);
  }

  .module__details summary {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-heading);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .module__details dl {
    display: grid;
    gap: var(--space-xs);
    margin-block-start: var(--space-2xs);
  }

  .module__details dt {
    font-weight: var(--weight-semibold);
  }

  .module__details dd {
    margin: 0;
  }
</style>
