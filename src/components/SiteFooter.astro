---
/**
 * The last cover of the page: one deep green field, as the charter's conclusion pages.
 * The logo and the name open it, the site map and the address sit beside them on panels
 * a tone step above the field, the questionnaire is the one gold thing on it and the one
 * thing to click, and the legal line closes it.
 */
import { Image } from 'astro:assets';
import logo from '../assets/dtt-logo.png';
import {
  area,
  brand,
  company,
  contactNav,
  legalNav,
  mainNav,
  phoneHref,
  surveyNav,
} from '../data/site';
import ToComplete from './ToComplete.astro';

const siteMap = [{ href: '/', label: 'Accueil' }, ...mainNav, contactNav];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Image
        class="site-footer__logo"
        src={logo}
        alt=""
        widths={[80, 160, 240]}
        sizes="80px"
        loading="lazy"
      />
      <div class="site-footer__wordmark">
        <p class="site-footer__name">{brand.name}</p>
        <p class="site-footer__tagline">{brand.tagline}</p>
      </div>
      <p class="site-footer__statement">
        Formations à la transition écologique et à la RSE pour les entreprises, les
        établissements d’enseignement et les collectivités du {area}.
      </p>
    </div>

    <nav class="site-footer__panel" aria-labelledby="footer-map-title">
      <p class="site-footer__heading" id="footer-map-title">Plan du site</p>
      {/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none */}
      <ul class="site-footer__links" role="list">
        {
          siteMap.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__panel">
      <p class="site-footer__heading">Nous trouver</p>
      <address>
        {company.address.street}<br />
        {company.address.postalCode}
        {company.address.city}, {area}<br />
        {
          company.phone ? (
            <a href={phoneHref(company.phone)}>{company.phone}</a>
          ) : (
            <ToComplete>téléphone</ToComplete>
          )
        }<br />
        {
          company.email ? (
            <a href={`mailto:${company.email}`}>{company.email}</a>
          ) : (
            <ToComplete>adresse e-mail</ToComplete>
          )
        }
      </address>
    </div>

    <a class="site-footer__survey" href={surveyNav.href}>
      <span class="site-footer__survey-title">Entreprise du {area}&nbsp;?</span>
      <span class="site-footer__survey-text">
        Dites-nous vos besoins en répondant au questionnaire.
      </span>
      <svg class="site-footer__arrow" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <path d="M14 34 L34 14 M18 14 H34 V30"></path>
      </svg>
    </a>

    <div class="site-footer__legal">
      <p>© {year} {company.name}</p>
      <nav aria-label="Informations légales">
        {/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none */}
        <ul class="site-footer__legal-links" role="list">
          {
            legalNav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  /*
   * One field, not a patchwork: everything laid on it is a tone step of the same deep
   * green, so the foot of the page reads as a single block. The gold is spent once, on
   * the questionnaire.
   */
  .site-footer {
    --color-focus: var(--color-accent-on-dark);
    padding-block: var(--space-chapter);
    background-color: var(--green-deep);
    color: var(--color-on-dark);
  }

  .site-footer :global(a) {
    color: var(--color-on-dark);
  }

  .site-footer__inner {
    display: grid;
    /* Stacked on a phone, the blocks need less air between them than side by side. */
    gap: var(--space-l);
  }

  @media (min-width: 40rem) {
    .site-footer__inner {
      gap: var(--space-xl) var(--space-l);
    }
  }

  /* Tablets: the two panels share a row under the brand. */
  @media (min-width: 40rem) {
    .site-footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__brand,
    .site-footer__survey,
    .site-footer__legal {
      grid-column: 1 / -1;
    }
  }

  /* Wide screens: the brand holds the left, the two panels the right. */
  @media (min-width: 64rem) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 3fr) minmax(0, 4fr);
    }

    .site-footer__brand {
      grid-column: 1;
    }
  }

  /* ---- The brand ---------------------------------------------------------- */
  .site-footer__brand {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    max-width: 34rem;
  }

  .site-footer__logo {
    width: 5rem;
    height: auto;
  }

  /* The name and what it stands for, set tight: one wordmark, two lines, two faces kept in
     two paragraphs. */
  .site-footer__wordmark {
    display: grid;
    gap: var(--space-3xs);
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: var(--weight-medium);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .site-footer__tagline {
    color: var(--color-accent-on-dark);
  }

  .site-footer__statement {
    color: var(--color-on-dark-muted);
  }

  /* ---- The two panels ------------------------------------------------------ */
  /*
   * Each panel is as tall as what it holds, not as tall as the row: stretched to a common
   * height, the shorter of the two would be mostly empty, which is what the foot of the
   * page looked like before.
   */
  .site-footer__panel {
    display: grid;
    align-self: start;
    gap: var(--space-s);
    padding: var(--space-m);
    background-color: var(--green-deep-raised);
  }

  /* Cream at the size of a lead: the light gold reached only 4.2:1 on the raised green. */
  .site-footer__heading {
    color: var(--cream);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
  }

  .site-footer__links {
    display: grid;
    gap: var(--space-3xs);
    padding: 0;
    list-style: none;
  }

  .site-footer__links a {
    display: inline-block;
    padding-block: var(--space-3xs);
  }

  address {
    font-style: normal;
    line-height: var(--leading-normal);
    overflow-wrap: anywhere;
  }

  /* ---- The questionnaire, one gold band and one link ----------------------- */
  .site-footer__survey {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-m);
    background-color: var(--gold);
    /* Only anthracite reads on the matt gold at text size (4.7:1). */
    color: var(--anthracite);
    text-decoration: none;
    transition: background-color var(--duration-base) var(--ease-out);
  }

  /* Two classes, so it wins over the cream given to every link of the footer above
     (one class and one element): cream on the gold read at 3:1 only. */
  .site-footer .site-footer__survey {
    color: var(--anthracite);
  }

  .site-footer__survey-title {
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
  }

  .site-footer__arrow {
    justify-self: end;
    width: 2.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 4;
    transition: transform var(--duration-base) var(--ease-out);
  }

  /* From the width where the three parts fit one line, the band becomes one line. */
  @media (min-width: 48rem) {
    .site-footer__survey {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-m);
    }

    .site-footer__arrow {
      width: 2rem;
    }
  }

  .site-footer__survey:hover,
  .site-footer__survey:focus-visible {
    background-color: var(--cream);
  }

  .site-footer__survey:hover .site-footer__arrow {
    transform: translate(4px, -4px);
  }

  .site-footer__survey:focus-visible {
    outline-color: var(--anthracite);
  }

  /* ---- The legal line ------------------------------------------------------ */
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-l);
    /* Space alone sets the legal line apart: no dividing rule. */
    padding-block-start: var(--space-l);
    color: var(--color-on-dark-muted);
    font-size: var(--step--1);
  }

  .site-footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-l);
    padding: 0;
    list-style: none;
  }
</style>
