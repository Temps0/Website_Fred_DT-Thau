---
/**
 * Footer as the last two rows of a board of colour tiles, on the page's cream ground:
 * who DT-Thau is, the site map, where to find it, the name set large, and the survey as
 * a gold tile that is one link.
 */
import {
  area,
  brand,
  company,
  contactNav,
  legalNav,
  mainNav,
  phoneHref,
  surveyNav,
} from '../data/site';
import ToComplete from './ToComplete.astro';

const siteMap = [{ href: '/', label: 'Accueil' }, ...mainNav, contactNav];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__board">
    <div class="tile tile--lagoon tile--identity">
      <p class="tile__statement">
        Formations à la transition écologique et à la RSE pour les entreprises, les
        établissements d’enseignement et les collectivités du {area}.
      </p>
      <div class="tile__legal">
        <p>© {year} {company.name}</p>
        <nav aria-label="Informations légales">
          {/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none */}
          <ul class="tile__links tile__links--inline" role="list">
            {
              legalNav.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    <nav class="tile tile--sage tile--nav" aria-label="Plan du site">
      {/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none */}
      <ul class="tile__links" role="list">
        {
          siteMap.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tile tile--sand tile--place">
      <p class="tile__title">{company.address.city}, {area}</p>
      <address>
        {company.address.street}<br />
        {company.address.postalCode}
        {company.address.city}<br />
        {
          company.phone ? (
            <a href={phoneHref(company.phone)}>{company.phone}</a>
          ) : (
            <ToComplete>téléphone</ToComplete>
          )
        }<br />
        {
          company.email ? (
            <a href={`mailto:${company.email}`}>{company.email}</a>
          ) : (
            <ToComplete>adresse e-mail</ToComplete>
          )
        }
      </address>
    </div>

    <div class="tile tile--raised tile--wordmark">
      <p class="tile__name">{brand.name}</p>
      <p>{brand.tagline}</p>
    </div>

    <a class="tile tile--gold tile--survey" href={surveyNav.href}>
      <span class="tile__title">Entreprise du {area}&nbsp;?</span>
      <span>Dites-nous vos besoins en répondant au questionnaire.</span>
      <svg class="tile__arrow" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <path d="M14 34 L34 14 M18 14 H34 V30" />
      </svg>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-2xs) var(--space-2xs) var(--space-2xs);
    background-color: var(--cream);
  }

  .site-footer__board {
    display: grid;
    gap: var(--space-2xs);
  }

  /* Two columns of tiles on tablets, the full board of twelve columns on wide screens. */
  @media (min-width: 40rem) {
    .site-footer__board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tile--identity,
    .tile--wordmark {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .site-footer__board {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: minmax(15rem, auto);
    }

    .tile--identity {
      grid-column: 1 / span 5;
    }

    .tile--nav {
      grid-column: 6 / span 3;
    }

    .tile--place {
      grid-column: 9 / span 4;
    }

    .tile--wordmark {
      grid-column: 1 / span 8;
      grid-row-end: span 1;
      min-height: 20rem;
    }

    .tile--survey {
      grid-column: 9 / span 4;
    }
  }

  .tile {
    display: grid;
    align-content: space-between;
    gap: var(--space-l);
    padding: var(--space-m);
    background-color: var(--tile);
    color: var(--color-text);
  }

  .tile--lagoon {
    --tile: var(--green-deep);
    --color-text: var(--cream);
    --color-link: var(--cream);
    --color-focus: var(--gold-light);
  }

  .tile--raised {
    --tile: var(--green-deep-raised);
    --color-text: var(--cream);
  }

  .tile--sage {
    --tile: var(--sage);
  }

  .tile--sand {
    --tile: var(--cream-strong);
  }

  .tile--gold {
    --tile: var(--gold);
    --color-text: var(--anthracite);
    --color-focus: var(--anthracite);
  }

  .tile :global(a) {
    color: var(--color-link, var(--color-text));
  }

  .tile__statement {
    max-width: 30rem;
    font-size: var(--step-1);
  }

  .tile__legal {
    display: grid;
    gap: var(--space-3xs);
  }

  .tile__title {
    color: inherit;
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
  }

  address {
    font-style: normal;
    overflow-wrap: anywhere;
  }

  .tile__links {
    display: grid;
    gap: var(--space-3xs);
    padding: 0;
    list-style: none;
  }

  .tile__links--inline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-m);
  }

  .tile__links a {
    display: inline-block;
    padding-block: var(--space-3xs);
  }

  .tile--nav .tile__links {
    font-size: var(--step-1);
  }

  .tile--wordmark {
    align-content: end;
    gap: var(--space-2xs);
  }

  .tile__name {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: var(--weight-medium);
    line-height: 0.85;
    letter-spacing: -0.03em;
  }

  /* The survey tile is one link. */
  .tile--survey {
    text-decoration: none;
    transition: background-color 180ms ease-out;
  }

  .tile--survey:hover,
  .tile--survey:focus-visible {
    --tile: var(--green-deep);
    --color-text: var(--cream);
  }

  .tile--survey:focus-visible {
    outline: 3px solid var(--cream);
    outline-offset: -6px;
  }

  .tile__arrow {
    justify-self: end;
    width: 3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 4;
    transition: transform 180ms ease-out;
  }

  .tile--survey:hover .tile__arrow {
    transform: translate(4px, -4px);
  }
</style>
