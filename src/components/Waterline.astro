---
/**
 * First screen of every page: the waterline of the Thau lagoon. A cream sky and a deep
 * green lagoon meet at the seam, and the page title is cut by it: green ink above the
 * water, cream ink below, as if half submerged. The Mont Saint-Clair and the oyster tables
 * stand on the horizon on either side of the title (drawn in code, from the view across
 * the lagoon from Mèze). The lead and the actions sit in the water.
 *
 * The title is set twice at the same height: the real h1 in the sky and an aria-hidden
 * copy in the water, each cut by the edge of its own field, so nothing ever lies on top of
 * the other. Each line is wrapped for the entrance animation.
 */
import { frenchSpacing } from '../lib/text';
import LagoonHorizon from './LagoonHorizon.astro';

interface Props {
  /** The title, one entry per line (two at most): the line breaks are authored. */
  lines: string[];
  /** id of the h1, for the section's aria-labelledby. */
  titleId: string;
  /**
   * Title size: "xl" for the home page, "l" for pages, "m" for titles with a long word
   * that must still fit a phone screen ("professionnalisante", "confidentialité").
   */
  size?: 'xl' | 'l' | 'm';
  /** Shorter screen for pages read rather than seen (legal pages, 404). */
  compact?: boolean;
}

const { lines, titleId, size = 'l', compact = false } = Astro.props;
const titleLines = lines.map((line) => frenchSpacing(line));
---

<section
  class:list={['waterline', `waterline--${size}`, { 'waterline--compact': compact }]}
  aria-labelledby={titleId}
>
  <div class="waterline__sky">
    <h1 id={titleId} class="waterline__title waterline__title--above">
      {
        titleLines.map((line) => (
          <span class="waterline__line">
            <span>{line}</span>
          </span>
        ))
      }
    </h1>
  </div>
  <div class="waterline__water chapter--lagoon">
    <p class="waterline__title waterline__title--below" aria-hidden="true">
      {
        titleLines.map((line) => (
          <span class="waterline__line">
            <span>{line}</span>
          </span>
        ))
      }
    </p>
    <div class="container waterline__content">
      <slot />
    </div>
  </div>

  <LagoonHorizon />
</section>

<style>
  .waterline {
    /* Where the sky meets the water, from the top of the section. */
    --seam: 50%;
    /* How far below the seam the title reaches: half of its last line. */
    --dip: 0.47em;
    position: relative;
    display: grid;
    grid-template-rows: var(--seam) 1fr;
    min-height: max(34rem, calc(100svh - var(--header-height)));
  }

  .waterline--compact {
    min-height: max(26rem, 62svh);
  }

  .waterline--xl {
    --title-size: clamp(3.25rem, 1rem + 10.5vw, 9.5rem);
  }

  .waterline--l {
    --title-size: clamp(2.75rem, 1rem + 8vw, 7.5rem);
  }

  .waterline--m {
    --title-size: clamp(1.75rem, 0.6rem + 6.4vw, 6rem);
  }

  /*
   * Each field cuts its own copy of the title. "clip", not "hidden": a scroll container
   * would let its grid row shrink below its content, and cut off the lead and the actions.
   */
  .waterline__sky,
  .waterline__water {
    position: relative;
    overflow: clip;
  }

  .waterline__sky {
    background-color: var(--cream);
  }

  /* The lagoon: a deep green field (.chapter--lagoon sets the inks that read on it). */
  .waterline__water {
    display: grid;
    align-items: end;
  }

  .waterline__content {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    /* Clear of the part of the title that dips below the seam. */
    padding-block: calc(var(--title-size) * 0.47 + var(--space-xl)) var(--space-xl);
    text-align: center;
  }

  .waterline__content :global(.lead) {
    max-width: 44rem;
  }

  .waterline__content :global(.actions) {
    justify-content: center;
  }

  /* ---- The title, cut by the seam --------------------------------------- */
  .waterline__title {
    position: absolute;
    inset-inline: 0;
    margin: 0;
    padding-inline: var(--gutter);
    color: var(--title-ink);
    font-family: var(--font-display);
    font-size: var(--title-size);
    font-weight: var(--weight-medium);
    line-height: 0.94;
    letter-spacing: -0.025em;
    text-align: center;
    text-wrap: balance;
    /* Both copies break a long word the same way, so they stay aligned. */
    hyphens: auto;
  }

  /* In the sky, the last line runs half a line past the bottom edge. */
  .waterline__title--above {
    --title-ink: var(--green-forest);
    bottom: calc(-1 * var(--dip));
  }

  /* In the water, the same title, its bottom half a line below the top edge. */
  .waterline__title--below {
    --title-ink: var(--cream);
    top: 0;
    transform: translateY(calc(-100% + var(--dip)));
  }

  .waterline__line {
    display: block;
    overflow: hidden;
    /* Room for accents and descenders inside the mask of the entrance animation. */
    padding-block: 0.06em;
    margin-block: -0.06em;
  }

  .waterline__line > span {
    display: block;
  }

  /* Browsers without overflow: clip (before Safari 16) would show both copies whole: the
     title then sits entirely in the sky. */
  @supports not (overflow: clip) {
    .waterline__title--above {
      bottom: 0;
    }

    .waterline__title--below {
      display: none;
    }
  }

  /* ---- Phones: the seam a little higher, more water for the lead ---------- */
  @media (max-width: 47.99rem) {
    .waterline {
      --seam: 44%;
    }
  }

  /* ---- Entrance: each line rises from behind its own baseline ------------ */
  @media (prefers-reduced-motion: no-preference) {
    .waterline__line > span {
      animation: waterline-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .waterline__line:nth-child(2) > span {
      animation-delay: 110ms;
    }

    .waterline__content {
      animation: waterline-fade 700ms 380ms ease-out both;
    }
  }

  @keyframes waterline-rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes waterline-fade {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>
