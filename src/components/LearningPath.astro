---
/**
 * The CAP TRANSITION path as in the catalogue: three steps, one per module. Order is
 * carried by size: three flat tiles stand side by side, bottom-aligned, each taller than
 * the one before, with the catalogue's verb (Décoder, Comprendre, Agir) set large inside.
 * The module title and the step sit under each tile.
 *
 * Laid out for a sage chapter. An optional "intro" slot (the section heading and lead)
 * fills the empty ground above the two smaller tiles on wide screens.
 */
import { getModules } from '../lib/modules';
import { frenchSpacing } from '../lib/text';

interface Props {
  /** Link each step to its module on the same page. */
  linkToModules?: boolean;
}

const { linkToModules = false } = Astro.props;
const modules = await getModules();
const hasIntro = Astro.slots.has('intro');
---

<div class:list={['path-board', { 'path-board--intro': hasIntro }]}>
  {
    hasIntro && (
      <div class="path-board__intro flow flow--m">
        <slot name="intro" />
      </div>
    )
  }
  {/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none */}
  <ol class="path" role="list" data-reveal>
    {
      modules.map((module) => (
        <li class="path__step">
          <div class="path__tile">
            <span class="path__verb">{module.data.verb}</span>
          </div>
          {linkToModules ? (
            <a class="path__title" href={`#${module.id}`}>
              {frenchSpacing(module.data.title)}
            </a>
          ) : (
            <span class="path__title">{frenchSpacing(module.data.title)}</span>
          )}
          <span class="path__detail">{frenchSpacing(module.data.pathStep)}</span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .path-board {
    display: grid;
    gap: var(--space-xl);
  }

  .path {
    display: grid;
    gap: var(--space-2xl);
    padding: 0;
    list-style: none;
  }

  .path__step {
    display: grid;
    gap: var(--space-3xs);
    align-content: end;
  }

  .path__tile {
    display: flex;
    align-items: flex-end;
    margin-block-end: var(--space-s);
    padding: var(--space-m);
    background-color: var(--tile);
    color: var(--tile-ink);
  }

  /* Cream, gold, then deep green: the colour deepens as the path goes on. */
  .path__step:nth-child(1) {
    --tile: var(--cream);
    --tile-ink: var(--green-forest);
    --tile-height: 9rem;
  }

  .path__step:nth-child(2) {
    --tile: var(--gold);
    --tile-ink: var(--anthracite);
    --tile-height: 12rem;
  }

  .path__step:nth-child(3) {
    --tile: var(--green-deep);
    --tile-ink: var(--cream);
    --tile-height: 15rem;
  }

  .path__tile {
    min-height: var(--tile-height);
  }

  .path__verb {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: var(--weight-medium);
    line-height: 0.95;
    letter-spacing: var(--tracking-display);
  }

  .path__title {
    color: var(--color-heading);
    font-size: var(--step-1);
    font-weight: var(--weight-bold);
  }

  .path__detail {
    color: var(--color-text-muted);
  }

  @media (min-width: 56rem) {
    .path {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
      gap: var(--space-l) var(--space-2xs);
    }

    .path__step:nth-child(1) {
      grid-column: 1 / span 3;
      --tile-height: 14rem;
    }

    .path__step:nth-child(2) {
      grid-column: 4 / span 4;
      --tile-height: 20rem;
    }

    .path__step:nth-child(3) {
      grid-column: 8 / span 5;
      --tile-height: 32rem;
    }

    /* The heading and lead fill the ground above the two smaller tiles. */
    .path-board--intro {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 0;
    }

    .path-board--intro .path {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .path-board__intro {
      grid-column: 1 / span 6;
      grid-row: 1;
      align-self: start;
      position: relative;
    }
  }
</style>
