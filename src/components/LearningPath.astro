---
/**
 * The CAP TRANSITION path as in the catalogue: three steps, one per module. Order is
 * carried by size: three flat tiles stand side by side, bottom-aligned, each taller than
 * the one before. Each tile holds a photograph of what its module deals with, above the
 * catalogue's verb (Décoder, Comprendre, Agir) set large. The module title and the step
 * sit under each tile.
 *
 * Laid out for a sage chapter. An optional "intro" slot (the section heading and lead)
 * sits above the path; on wide screens it reaches down into the empty corner the rising
 * line leaves above the first tiles.
 */
import { Image } from 'astro:assets';
import { type Photo, photos } from '../data/photos';
import { getModules } from '../lib/modules';
import { frenchSpacing } from '../lib/text';

interface Props {
  /**
   * Make each step a link to its module card: "" for the cards on the same page,
   * "/programmes/" from another page. No links when omitted.
   */
  linkTo?: string;
}

const { linkTo } = Astro.props;
/* A linked step is one link: tile, verb and title (its photograph is then decorative). */
const Step = linkTo !== undefined ? 'a' : 'div';
const modules = await getModules();
const hasIntro = Astro.slots.has('intro');

const modulePhotos: Record<string, Photo> = {
  climat: photos.warmingStripes,
  rse: photos.strategyWorkshop,
  carbone: photos.cargoBike,
};
---

<div class="path-board">
  {
    hasIntro && (
      <div class="path-board__intro flow flow--m">
        <slot name="intro" />
      </div>
    )
  }
  {/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none */}
  <ol class="path" role="list" data-reveal>
    {
      modules.map((module) => {
        const photo = modulePhotos[module.id];
        return (
          <li class="path__step">
            <Step class="path__head" href={linkTo !== undefined ? `${linkTo}#${module.id}` : undefined}>
              <span class="path__tile">
                {photo && (
                  <Image
                    class="path__photo"
                    src={photo.src}
                    alt={linkTo !== undefined ? '' : photo.alt}
                    widths={[400, 640, 960]}
                    sizes="(min-width: 56rem) 40vw, 100vw"
                  />
                )}
                <span class="path__verb display">{module.data.verb}</span>
              </span>
              <span class="path__title">{frenchSpacing(module.data.title)}</span>
            </Step>
            <span class="path__detail">{frenchSpacing(module.data.pathStep)}</span>
          </li>
        );
      })
    }
  </ol>
</div>

<style>
  .path-board {
    display: grid;
    gap: var(--space-xl);
  }

  .path {
    display: grid;
    gap: var(--space-2xl);
    padding: 0;
    list-style: none;
    container-type: inline-size;
  }

  .path__step {
    display: grid;
    gap: var(--space-3xs);
    align-content: end;
  }

  .path__head {
    display: grid;
    gap: var(--space-3xs);
    color: inherit;
    text-decoration: none;
  }

  .path__tile {
    display: flex;
    flex-direction: column;
    min-height: var(--tile-height);
    margin-block-end: var(--space-s);
    background-color: var(--tile);
    color: var(--tile-ink);
  }

  /* The picture takes whatever height the verb leaves: it grows with its tile. */
  .path__photo {
    flex: 1;
    width: 100%;
    min-height: 0;
    object-fit: cover;
  }

  /* Cream, gold, then deep green: the colour deepens as the path goes on. */
  .path__step:nth-child(1) {
    --tile: var(--cream);
    --tile-ink: var(--green-forest);
    --tile-height: 14rem;
  }

  .path__step:nth-child(2) {
    --tile: var(--gold);
    --tile-ink: var(--anthracite);
    --tile-height: 17rem;
  }

  .path__step:nth-child(3) {
    --tile: var(--green-deep);
    --tile-ink: var(--cream);
    --tile-height: 20rem;
  }

  .path__verb {
    padding: var(--space-s) var(--space-m) var(--space-m);
    font-size: var(--step-4);
    line-height: 0.95;
  }

  .path__title {
    color: var(--color-heading);
    font-size: var(--step-1);
    font-weight: var(--weight-bold);
  }

  .path__detail {
    color: var(--color-text-muted);
  }

  /* A linked step answers the pointer on its whole tile, and its title reads as a link. */
  a.path__head .path__title {
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-underline-offset: 0.15em;
  }

  a.path__head .path__photo {
    transition: opacity var(--duration-base) var(--ease-out);
  }

  a.path__head:hover .path__photo {
    opacity: 0.85;
  }

  a.path__head:hover .path__title {
    text-decoration-thickness: 2px;
  }

  a.path__head:focus-visible {
    outline-offset: 4px;
  }

  @media (min-width: 56rem) {
    .path {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
      gap: var(--space-l) var(--space-2xs);
    }

    .path__step:nth-child(1) {
      grid-column: 1 / span 3;
      --tile-height: 16rem;
      --cut: 6rem;
    }

    .path__step:nth-child(2) {
      grid-column: 4 / span 4;
      --tile-height: 24rem;
      --cut: 8rem;
    }

    .path__step:nth-child(3) {
      grid-column: 8 / span 5;
      --tile-height: 34rem;
      --cut: 10rem;
    }

    /*
     * Crescendo: one straight line rises from the left of the path to the top right corner
     * of the last tile. With these heights (16, 24, 34rem) over 3, 4 and 5 columns, the top
     * right corners of the three tiles already lie on that line (24rem of rise across the
     * path), so each tile is cut from its own corner down by 24rem times its share of the
     * width: 6, 8 and 10rem. The verbs, at the foot of the tiles, are never reached.
     */
    /*
     * The steps start on one line and each tile is pushed down to the height of the tallest
     * (34rem), so the tiles' feet stay level whatever the length of the titles under them.
     */
    .path__tile {
      margin-block-start: calc(34rem - var(--tile-height));
      height: var(--tile-height);
      clip-path: polygon(0 var(--cut), 100% 0, 100% 100%, 0 100%);
    }

    /*
     * The block's four outer corners are slightly rounded; the joints between tiles stay
     * square. Three of them are corners of a tile's box (a border radius, with the picture
     * clipped to it); the top left one is where the slope starts, so the first tile's cut
     * draws it as a short arc of five points (radius about 0.8rem).
     */
    .path__tile {
      overflow: hidden;
    }

    .path__step:nth-child(1) .path__tile {
      border-end-start-radius: 0.75rem;
      clip-path: polygon(
        0 calc(var(--cut) + 0.6rem),
        0.04rem calc(var(--cut) + 0.32rem),
        0.16rem calc(var(--cut) + 0.12rem),
        0.35rem calc(var(--cut) - 0.06rem),
        0.57rem calc(var(--cut) - 0.17rem),
        100% 0,
        100% 100%,
        0 100%
      );
    }

    .path__step:nth-child(3) .path__tile {
      border-start-end-radius: 0.75rem;
      border-end-end-radius: 0.75rem;
    }

    /*
     * One size for the three verbs, capped so that "Comprendre" (5.7 em wide, the tightest
     * fit) stays inside the middle tile: a third of the path, less its padding and room.
     */
    .path__verb {
      font-size: min(var(--step-4), calc((100cqi / 3 - 4rem) / 6));
    }
  }

  /*
   * The intro in the corner above the slope. It keeps to the left 42% of the board, where
   * the free corner is at least 24rem x 58% = 13.9rem deep, and the path is drawn up
   * 11.5rem under it: the intro only reaches into empty ground, with 2.4rem to spare. Both
   * stay in the flow, so a longer intro (a larger font, wider text spacing) pushes the path
   * down instead of running over it. The intro is drawn above the path's links, whose boxes
   * are empty there, so its text stays selectable.
   */
  @media (min-width: 56rem) {
    .path-board {
      gap: 0;
    }

    .path-board__intro {
      position: relative;
      z-index: 1;
      max-width: 42%;
      /* A short intro still ends below the top of the path, never under it. */
      min-height: 11.5rem;
    }

    .path {
      margin-block-start: -11.5rem;
    }

    /*
     * A cut tile shows its focus on what is visible: the link's rectangle would cross the
     * intro above the slope. An inset ring in the tile's own ink frames the verb's band,
     * and the title's underline thickens.
     */
    a.path__head:focus-visible {
      outline: none;
    }

    a.path__head:focus-visible .path__verb {
      outline: var(--focus-width) solid var(--tile-ink);
      outline-offset: calc(-2 * var(--focus-width));
    }

    a.path__head:focus-visible .path__title {
      text-decoration-thickness: 3px;
    }
  }
</style>
