---
import type { CollectionEntry } from 'astro:content';
import { contactNav } from '../data/site';
import ContentText from './ContentText.astro';

interface Props {
  formation: CollectionEntry<'formations'>;
}

const { formation } = Astro.props;
const { data } = formation;
const titleId = `formation-${formation.id}`;

const essentials = [
  { term: 'Objectif', value: data.objective },
  { term: 'Public', value: data.audience },
  { term: 'Durée', value: data.duration },
  { term: 'Format', value: data.format },
  { term: 'Bénéfice pour votre entreprise', value: data.benefit },
];

const details = [
  { term: 'Prérequis', value: data.prerequisites },
  { term: 'Modalités et délais d’accès', value: data.access },
  { term: 'Tarif', value: data.price },
  { term: 'Méthodes pédagogiques', value: data.methods },
  { term: 'Évaluation', value: data.assessment },
  { term: 'Accessibilité', value: data.accessibility },
].filter((item): item is { term: string; value: string } => Boolean(item.value));
---

<article class="formation" id={formation.id} aria-labelledby={titleId}>
  <h3 id={titleId}><ContentText value={data.title} /></h3>

  <dl class="formation__facts">
    {
      essentials.map((item) => (
        <div>
          <dt>{item.term}</dt>
          <dd>
            <ContentText value={item.value} />
          </dd>
        </div>
      ))
    }
  </dl>

  {
    details.length > 0 && (
      <details class="formation__details">
        <summary>Prérequis, accès, tarif et évaluation</summary>
        <dl class="formation__facts">
          {details.map((item) => (
            <div>
              <dt>{item.term}</dt>
              <dd>
                <ContentText value={item.value} />
              </dd>
            </div>
          ))}
        </dl>
      </details>
    )
  }

  <p class="formation__action">
    <a class="button button--secondary" href={contactNav.href}>
      Échanger sur votre besoin<span class="visually-hidden">&nbsp;: {data.title}</span>
    </a>
  </p>
</article>

<style>
  .formation {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-m);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-m);
    background-color: var(--color-bg);
  }

  .formation__facts {
    display: grid;
    gap: var(--space-xs);
  }

  .formation__facts dt {
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .formation__facts dd {
    margin: 0;
  }

  .formation__details summary {
    padding-block: var(--space-2xs);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .formation__details[open] summary {
    margin-block-end: var(--space-xs);
  }

  .formation__action {
    margin-block-start: auto;
  }
</style>
