---
/**
 * The three audiences of the catalogue, as rows of a list: the audience named large, its
 * sentence and a link to its programme. Space separates the rows; no lines, no cards.
 */
import { audiences } from '../data/audiences';
import { frenchSpacing } from '../lib/text';

interface Props {
  /** Heading level of the audience names, to fit the page outline. */
  as?: 'h2' | 'h3';
}

const { as: Heading = 'h3' } = Astro.props;
---

{/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none */}
<ul class="audiences" role="list" data-reveal>
  {
    audiences.map((audience) => (
      <li class="audience">
        <Heading class="audience__name">{audience.name}</Heading>
        <p class="audience__summary">{frenchSpacing(audience.summary)}</p>
        <a class="audience__link" href={`/programmes/#${audience.id}`}>
          Voir le programme<span class="visually-hidden">&nbsp;: {audience.name}</span>
          <span aria-hidden="true">&nbsp;→</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .audiences {
    display: grid;
    gap: var(--space-2xl);
    padding: 0;
    list-style: none;
  }

  .audience {
    display: grid;
    gap: var(--space-xs);
  }

  @media (min-width: 56rem) {
    .audience {
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr);
      align-items: baseline;
      gap: var(--space-l);
    }
  }

  .audience__name {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: var(--weight-medium);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .audience__link {
    font-weight: var(--weight-semibold);
  }

  .audience__link span[aria-hidden] {
    display: inline-block;
    transition: transform 160ms ease-out;
  }

  .audience__link:hover span[aria-hidden] {
    transform: translateX(4px);
  }
</style>
