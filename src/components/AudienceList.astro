---
/**
 * The three audiences of the catalogue, as a staircase: each row starts further right
 * than the one above, with a photograph of its sector, without anyone who could be recognised, its name set large, its
 * sentence and a cue to its programme. The name is the link and its target area covers
 * the whole row. Space separates the rows; no lines, no cards.
 */
import { Picture } from 'astro:assets';
import { audiences } from '../data/audiences';
import { type Photo, photos } from '../data/photos';
import { frenchSpacing } from '../lib/text';

interface Props {
  /** Heading level of the audience names, to fit the page outline. */
  as?: 'h2' | 'h3';
}

const { as: Heading = 'h3' } = Astro.props;

const audiencePhotos: Record<string, Photo> = {
  ecoles: photos.climateFreskStudents,
  pme: photos.oysterTables,
  collectivites: photos.lido,
};
---

{/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none */}
<ul class="audiences" role="list" data-reveal>
  {
    audiences.map((audience) => {
      const photo = audiencePhotos[audience.id];
      return (
        <li class="audience">
          {photo && (
            <Picture
              formats={['avif', 'webp']}
              class="audience__photo"
              src={photo.src}
              alt={photo.alt}
              widths={[320, 480, 720]}
              sizes="(min-width: 56rem) 26rem, 100vw"
            />
          )}
          <div class="audience__text">
            <Heading class="audience__name display">
              <a class="audience__link" href={`/programmes/#${audience.id}`}>
                {audience.name}
              </a>
            </Heading>
            <p class="audience__summary">{frenchSpacing(audience.summary)}</p>
            <span class="audience__more" aria-hidden="true">
              Voir le programme <span class="audience__arrow">→</span>
            </span>
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .audiences {
    display: grid;
    gap: var(--space-2xl);
    padding: 0;
    list-style: none;
  }

  .audience {
    position: relative;
    display: grid;
    gap: var(--space-s);
  }

  .audience__photo {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .audience__text {
    display: grid;
    gap: var(--space-2xs);
    justify-items: start;
  }

  .audience__name {
    font-size: var(--step-4);
  }

  .audience__summary {
    max-width: 32rem;
  }

  .audience__link {
    color: inherit;
    text-decoration: none;
  }

  .audience__more {
    color: var(--color-link);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-underline-offset: 0.15em;
  }

  /* The link covers its whole row: picture, name and sentence answer the pointer. */
  .audience__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .audience__arrow {
    display: inline-block;
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .audience:hover .audience__arrow {
    transform: translateX(4px);
  }

  .audience:hover .audience__name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  /* The focus ring of the link outlines the whole row it covers, where :has() is known;
     elsewhere the link keeps its own ring. */
  @supports selector(:has(*)) {
    .audience__link:focus-visible {
      outline: none;
    }
  }

  .audience:has(.audience__link:focus-visible) {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: 6px;
  }

  /* Each row a step further right than the one above. */
  @media (min-width: 56rem) {
    .audiences {
      gap: var(--space-xl);
    }

    /* The picture at a readable size and the text taking the rest of the row, so the
       staircase spans the width instead of leaving its right side empty. */
    .audience {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-xl);
      margin-inline-start: calc(var(--step, 0) * 6vw);
    }

    .audience:nth-child(2) {
      --step: 1;
    }

    .audience:nth-child(3) {
      --step: 2;
    }
  }
</style>
