---
/**
 * Wireframe annotation explaining the role of a block. Hidden when the visitor unticks
 * "Afficher les notes" in the wireframe banner; removed together with the wireframe.
 */
interface Props {
  /** Marks a block that is not in the client brief but suggested by us. */
  proposal?: boolean;
}

const { proposal = false } = Astro.props;
---

<p class="wire-note">
  <span class="wire-note__label">{proposal ? 'Proposition' : 'Note'}</span>
  <slot />
</p>

<style>
  .wire-note {
    max-width: var(--measure);
    padding: var(--space-2xs) var(--space-xs);
    border: var(--border-width) dashed var(--color-note-border);
    border-radius: var(--radius-s);
    background-color: var(--color-note-bg);
    color: var(--color-note-text);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .wire-note__label {
    margin-inline-end: var(--space-3xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  :global(:root:has(#wire-notes-toggle:not(:checked))) .wire-note {
    display: none;
  }
</style>
