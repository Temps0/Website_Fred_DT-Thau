---
/**
 * Closing call to action of a page, on the matt gold field: the page's idea returns as a
 * two-line title set very large, then, on one line along the foot of the field, what
 * happens next and the button that does it.
 */
import { frenchSpacing } from '../lib/text';
import LinkButton from './LinkButton.astro';

interface Props {
  href: string;
  /** The title, one entry per line (two at most), echoing the page's own title. */
  lines: string[];
  /** What happens next, one sentence. */
  sentence: string;
  /** Label of the button, named for what it does. */
  action?: string;
  /** id of the heading, unique on the page. */
  titleId?: string;
}

const {
  href,
  lines,
  sentence,
  action = 'Réserver un échange de 30 minutes',
  titleId = 'cta-title',
} = Astro.props;
---

<section class="cta-band chapter chapter--gold" aria-labelledby={titleId}>
  <div class="container cta-band__inner" data-reveal>
    <h2 id={titleId} class="cta-band__title">
      {/* A space between the lines keeps the heading's text whole for assistive technologies. */}
      {
        lines.map((line, index) => (
          <span class="cta-band__line">
            {index > 0 ? ' ' : ''}
            {frenchSpacing(line)}
          </span>
        ))
      }
    </h2>
    <div class="cta-band__foot">
      <p class="cta-band__sentence">{frenchSpacing(sentence)}</p>
      <LinkButton href={href}>{action}</LinkButton>
    </div>
  </div>
</section>

<style>
  .cta-band__inner {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-2xl);
  }

  /* On a wide screen the band is a screen of its own; on a phone it ends with its button. */
  @media (min-width: 56rem) {
    .cta-band__inner {
      min-height: max(22rem, 52svh);
    }
  }

  .cta-band__title {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: clamp(3rem, 1rem + 10vw, 11rem);
    font-weight: var(--weight-medium);
    line-height: 0.92;
    letter-spacing: -0.025em;
  }

  .cta-band__line {
    display: block;
  }

  .cta-band__foot {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .cta-band__sentence {
    max-width: 30rem;
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
  }

  @media (min-width: 40rem) {
    .cta-band__foot {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }
</style>
