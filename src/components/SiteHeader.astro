---
import { brand, contactNav, mainNav } from '../data/site';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href || currentPath === href.replace(/\/$/, '');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-current={currentPath === '/' ? 'page' : undefined}>
      <span class="site-header__name">{brand.name}</span>
      <span class="site-header__tagline">{brand.tagline}</span>
    </a>

    <nav class="site-nav" aria-label="Navigation principale" data-site-nav>
      <button
        type="button"
        class="site-nav__toggle"
        aria-expanded="false"
        aria-controls="site-nav-list"
        data-site-nav-toggle
      >
        Menu
        <svg
          class="site-nav__chevron"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M6 9 L12 15 L18 9"></path>
        </svg>
      </button>
      <ul class="site-nav__list" id="site-nav-list">
        {
          mainNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        class="button button--primary site-nav__cta"
        href={contactNav.href}
        aria-current={isCurrent(contactNav.href) ? 'page' : undefined}
      >
        {contactNav.label}
      </a>
    </nav>
  </div>
</header>

<script>
  // Mobile disclosure menu. Without JavaScript the list stays visible (see the styles below).
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');
  const toggle = nav?.querySelector<HTMLButtonElement>('[data-site-nav-toggle]');

  if (nav && toggle) {
    const setOpen = (isOpen: boolean) => {
      toggle.setAttribute('aria-expanded', String(isOpen));
      nav.toggleAttribute('data-open', isOpen);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    // The menu closes when the visitor clicks or tabs anywhere else on the page.
    document.addEventListener('click', (event) => {
      if (nav.hasAttribute('data-open') && !nav.contains(event.target as Node)) {
        setOpen(false);
      }
    });

    nav.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (nav.hasAttribute('data-open') && next && !nav.contains(next)) {
        setOpen(false);
      }
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: var(--z-header);
    /* Cream, straight above the deep green first screen: no line between them. */
    background-color: var(--cream);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    min-height: var(--header-height);
    padding-block: var(--space-2xs);
  }

  /* Text wordmark until the logo file is provided (the charter forbids redrawing it). */
  .site-header__brand {
    display: grid;
    margin-inline-end: auto;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    line-height: 1.1;
    text-decoration: none;
  }

  .site-header__name {
    white-space: nowrap;
  }

  .site-header__tagline {
    color: var(--color-accent-text);
    font-family: var(--font-body);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2xs) var(--space-s);
  }

  .site-nav__toggle {
    display: none;
    gap: var(--space-2xs);
    min-height: var(--tap-min);
    padding-inline: var(--space-s);
    border: 0;
    background-color: var(--sage);
    font-weight: var(--weight-semibold);
    transition: background-color var(--duration-base) var(--ease-out);
  }

  .site-nav__toggle:hover,
  .site-nav__toggle[aria-expanded='true'] {
    background-color: var(--cream-strong);
  }

  /* The chevron points down while the menu is closed, up while it is open. */
  .site-nav__chevron {
    flex: none;
    width: 1.1em;
    height: 1.1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .site-nav__toggle[aria-expanded='true'] .site-nav__chevron {
    transform: rotate(180deg);
  }

  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    padding: 0;
    list-style: none;
  }

  .site-nav__list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--color-text);
    text-decoration: none;
  }

  .site-nav__list a:hover,
  .site-nav__list a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .site-nav__list a[aria-current='page'] {
    font-weight: var(--weight-semibold);
  }

  .site-nav__cta[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  /* Mobile: when scripting is enabled the list collapses behind the "Menu" button, while
     the contact call to action stays visible. The media query needs no inline script, so the
     Content Security Policy can stay strict. */
  @media (max-width: 47.99rem) and (scripting: enabled) {
    /* Only "Menu" and "Contact" are left in the bar: keep them side by side. */
    .site-nav {
      flex-wrap: nowrap;
    }

    .site-nav__toggle {
      display: inline-flex;
      align-items: center;
    }

    .site-nav__list {
      display: none;
    }

    .site-nav[data-open] .site-nav__list {
      position: absolute;
      inset-inline: 0;
      inset-block-start: 100%;
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: var(--space-2xs) var(--gutter) var(--space-s);
      background-color: var(--cream-strong);
    }

    .site-nav[data-open] .site-nav__list a {
      width: 100%;
    }
  }

  /* The tagline would wrap beside "Menu" and "Contact": the footer still shows it. */
  @media (max-width: 25rem) {
    .site-header__tagline {
      display: none;
    }
  }

  @media (max-width: 22rem) {
    .site-header__brand {
      font-size: var(--step-1);
    }

    .site-nav {
      gap: var(--space-2xs);
    }

    /* Room for the chevron: the bar must fit a 320px screen without scrolling sideways. */
    .site-nav__toggle,
    .site-nav__cta {
      padding-inline: var(--space-xs);
    }

    .site-nav__toggle {
      gap: var(--space-3xs);
    }
  }
</style>
