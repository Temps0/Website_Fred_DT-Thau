---
/**
 * First screen of every page: one deep green field, as the charter's covers. The title is
 * set large and flush left, its two lines in two inks (cream, then light gold), so the
 * break reads as a change of voice. Each line rises into place on load.
 *
 * Two compositions:
 * - without a photograph, the field is the whole first screen: the title fills its upper
 *   part and the lead and actions sit at its foot, flush left under the title;
 * - with a photograph, the title, lead and actions take the left of the field and the
 *   picture runs to the right edge, the full height of the screen.
 */
import { Image } from 'astro:assets';
import type { Photo } from '../data/photos';
import { frenchSpacing } from '../lib/text';

interface Props {
  /** The title, one entry per line (two at most): the line breaks are authored. */
  lines: string[];
  /** id of the h1, for the section's aria-labelledby. */
  titleId: string;
  /**
   * Title size: "xl" for the home page, "l" for pages, "m" for titles with a long word
   * that must still fit a phone screen ("professionnalisante", "confidentialité").
   */
  size?: 'xl' | 'l' | 'm';
  /** Shorter screen, for pages read rather than seen and for the forms. */
  compact?: boolean;
  /** Dominant picture of the page, beside the title. */
  photo?: Photo;
}

const { lines, titleId, size = 'l', compact = false, photo } = Astro.props;
const titleLines = lines.map((line) => frenchSpacing(line));
---

<section
  class:list={[
    'page-hero',
    'chapter--lagoon',
    `page-hero--${size}`,
    { 'page-hero--compact': compact, 'page-hero--photo': photo },
  ]}
  aria-labelledby={titleId}
>
  <div class="container page-hero__inner">
    <h1 id={titleId} class="page-hero__title">
      {
        titleLines.map((line) => (
          <span class="page-hero__line">
            <span>{line}</span>
          </span>
        ))
      }
    </h1>
    <div class="page-hero__content">
      <slot />
    </div>
  </div>
  {
    photo && (
      <figure class="page-hero__figure">
        <span class="page-hero__frame">
          <Image
            class="page-hero__photo"
            src={photo.src}
            alt={photo.alt}
            widths={[640, 960, 1280, 1920]}
            sizes="(min-width: 56rem) 45vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </span>
        <figcaption class="page-hero__caption">{frenchSpacing(photo.caption)}</figcaption>
      </figure>
    )
  }
</section>

<style>
  .page-hero {
    display: grid;
    /* Its own width, scrollbar excluded, sets the margins of the text beside a photograph. */
    container-type: inline-size;
  }

  /* On a wide screen the field is the whole first screen; on a phone it ends with its text. */
  @media (min-width: 56rem) {
    .page-hero {
      min-height: max(34rem, calc(100svh - var(--header-height)));
    }

    .page-hero--compact {
      min-height: max(20rem, 46svh);
    }
  }

  .page-hero--xl {
    /*
     * Sized so that "transition écologique" holds one line from 320px up: about 7.8em wide
     * when large, 9.3em at phone sizes, where the face's optical size widens its letters.
     */
    --title-size: clamp(1.875rem, -0.5rem + 11vw, 11rem);
  }

  .page-hero--l {
    --title-size: clamp(2.75rem, 1rem + 8vw, 7.5rem);
  }

  .page-hero--m {
    --title-size: clamp(1.75rem, 0.6rem + 6.4vw, 6rem);
  }

  /* The title at the top, the lead and actions at the foot: the field holds both ends. */
  .page-hero__inner {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-2xl);
    padding-block: var(--space-2xl) var(--space-chapter);
  }

  .page-hero--compact .page-hero__inner {
    padding-block: var(--space-2xl);
  }

  .page-hero__title {
    margin: 0;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: var(--title-size);
    font-weight: var(--weight-medium);
    line-height: 0.94;
    letter-spacing: -0.025em;
    hyphens: auto;
  }

  /* Second line in the light gold: two inks, one voice changing to the other. */
  .page-hero__line:nth-child(2) {
    color: var(--color-accent-on-dark);
  }

  .page-hero__line {
    display: block;
    overflow: hidden;
    /*
     * Room for accents and descenders inside the mask of the entrance animation: the
     * line box is shorter than the face's ink (line-height 0.94), so the mask has to be
     * taller than the line or it cuts the "É" and the tail of the "g" and the "q".
     */
    padding-block: 0.18em;
    margin-block: -0.18em;
  }

  .page-hero__line > span {
    display: block;
  }

  .page-hero__content {
    display: grid;
    align-content: end;
    justify-items: start;
    gap: var(--space-m);
  }

  /* The lead and every paragraph under the title keep the same reading width. */
  .page-hero__content > :global(p) {
    max-width: 38rem;
  }

  @media (min-width: 56rem) {
    /* Without a picture, the lead and actions sit at the foot of the field, under the
       first letters of the title: one left edge for the whole screen. */
    .page-hero:not(.page-hero--photo) .page-hero__content {
      width: min(100%, 44rem);
    }
  }

  /* ---- With a photograph ---------------------------------------------------- */
  .page-hero__figure {
    margin: 0;
  }

  /* The frame crops the picture while it drifts. */
  .page-hero__frame {
    display: block;
    overflow: hidden;
  }

  .page-hero__photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /*
   * On a phone the picture ends the field, so its caption would sit right above the next
   * chapter's heading and read as a label for it: the alt text and the credits suffice.
   */
  .page-hero__caption {
    display: none;
    padding: var(--space-2xs) var(--space-s) var(--space-s);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  @media (min-width: 56rem) {
    .page-hero--photo {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    /* The text keeps the page's left margin; the picture runs to the right edge. */
    .page-hero--photo .page-hero__inner {
      width: auto;
      margin-inline: max(var(--gutter), (100cqi - var(--container-max)) / 2) var(--space-xl);
    }

    .page-hero--photo .page-hero__figure {
      display: grid;
      grid-template-rows: 1fr auto;
    }

    .page-hero--photo .page-hero__frame,
    .page-hero--photo .page-hero__photo {
      height: 100%;
    }

    .page-hero--photo .page-hero__photo {
      aspect-ratio: auto;
    }

    .page-hero__caption {
      display: block;
    }
  }

  /* ---- Entrance: each line rises from behind its own baseline ------------ */
  @media (prefers-reduced-motion: no-preference) {
    .page-hero__line > span {
      animation: page-hero-rise 900ms var(--ease-out-strong) both;
    }

    .page-hero__line:nth-child(2) > span {
      animation-delay: 110ms;
    }

    .page-hero__content,
    .page-hero__figure {
      animation: page-hero-fade 700ms 380ms ease-out both;
    }

    /* The photograph settles slowly into place: the page's one moving picture. */
    .page-hero__photo {
      /* Done within five seconds, so no motion runs on without a way to stop it (WCAG 2.2.2). */
      animation: page-hero-drift 4.5s var(--ease-out-strong) both;
    }
  }

  @keyframes page-hero-drift {
    from {
      transform: scale(1.08);
    }
  }

  @keyframes page-hero-rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes page-hero-fade {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>
