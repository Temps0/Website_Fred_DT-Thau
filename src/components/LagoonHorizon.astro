---
/**
 * The horizon of the Thau lagoon seen from Mèze, drawn flat in the charter's colours:
 * the Mont Saint-Clair of Sète above the water on the right, rows of oyster tables
 * standing in the lagoon on both sides, and ripples drifting slowly. The middle stays
 * empty for the page title. Decorative: hidden from assistive technologies.
 *
 * Coordinates: viewBox 1600 × 240, the waterline at y = 120 (the seam of Waterline).
 */

/** Posts of one row of oyster tables: x of the first post, count, spacing, height. */
const rows = [
  { x: 24, count: 6, gap: 30, height: 30, width: 4, bar: 4 },
  { x: 52, count: 5, gap: 22, height: 16, width: 3, bar: 3 },
  { x: 1424, count: 6, gap: 30, height: 30, width: 4, bar: 4 },
  { x: 1446, count: 6, gap: 22, height: 16, width: 3, bar: 3 },
];

const ripples = [
  [30, 176, 90],
  [150, 196, 50],
  [70, 214, 100],
  [180, 168, 36],
  [1430, 180, 100],
  [1520, 200, 60],
  [1460, 220, 90],
  [1400, 164, 40],
];
---

<svg
  class="lagoon-horizon"
  viewBox="0 0 1600 240"
  aria-hidden="true"
  focusable="false"
>
  <path
    class="lagoon-horizon__hill"
    d="M1330 120 C1380 112 1410 98 1440 88 C1468 78 1490 66 1516 66 C1546 66 1572 84 1600 94 L1600 120 Z"
  />
  <g class="lagoon-horizon__tables">
    {
      rows.map((row) => (
        <g>
          <rect
            x={row.x - 6}
            y={120}
            width={(row.count - 1) * row.gap + row.width + 12}
            height={row.bar}
          />
          {Array.from({ length: row.count }, (_, index) => (
            <rect x={row.x + index * row.gap} y={118} width={row.width} height={row.height} />
          ))}
        </g>
      ))
    }
  </g>
  <g class="lagoon-horizon__ripples">
    {ripples.map(([x, y, width]) => <rect x={x} y={y} width={width} height={3} />)}
  </g>
</svg>

<style>
  .lagoon-horizon {
    position: absolute;
    inset-inline: 0;
    top: calc(var(--seam, 50%) - 7.5vw);
    width: 100%;
    height: 15vw;
    pointer-events: none;
  }

  .lagoon-horizon__hill {
    fill: var(--sage);
  }

  .lagoon-horizon__tables,
  .lagoon-horizon__ripples {
    fill: var(--green-deep-lit);
  }

  /* The title spans the whole width of a phone: the horizon would run into it. */
  @media (max-width: 47.99rem) {
    .lagoon-horizon {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .lagoon-horizon__ripples {
      animation: lagoon-drift 14s ease-in-out infinite alternate;
    }
  }

  @keyframes lagoon-drift {
    to {
      transform: translateX(-36px);
    }
  }
</style>
