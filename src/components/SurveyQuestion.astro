---
/**
 * Renders one survey question as accessible form controls: grouped choices in a fieldset
 * with a legend, free text with a label. Field names are the question ids. After a failed
 * post it shows the previous answer and the error, linked to the controls.
 */

import { questionFieldId, type SurveyAnswer, type SurveyQuestion } from '../lib/survey';
import { frenchSpacing } from '../lib/text';

interface Props {
  question: SurveyQuestion;
  value?: SurveyAnswer;
  error?: string;
}

const { question, value = '', error } = Astro.props;
const fieldId = questionFieldId(question);
const helpId = question.help ? `${fieldId}__help` : undefined;
const errorId = error ? `${fieldId}__error` : undefined;
const describedBy = [helpId, errorId].filter(Boolean).join(' ') || undefined;
const invalid = error ? 'true' : undefined;
const label = frenchSpacing(question.label);
const help = question.help ? frenchSpacing(question.help) : undefined;
const requiredMark = question.required ? ' (obligatoire)' : '';

const isChecked = (option: string) =>
  Array.isArray(value) ? value.includes(option) : value === option;

const scaleSteps =
  question.type === 'scale'
    ? Array.from({ length: question.max - question.min + 1 }, (_, index) => {
        const step = question.min + index;
        const hint =
          step === question.min
            ? question.minLabel
            : step === question.max
              ? question.maxLabel
              : undefined;
        return { step, hint };
      })
    : [];
---

{
  (question.type === 'short-text' || question.type === 'long-text') && (
    <div class:list={['question', { 'question--invalid': error }]}>
      <label class="question__label" for={fieldId}>
        {label}
        {requiredMark}
      </label>
      {help && (
        <p class="question__help" id={helpId}>
          {help}
        </p>
      )}
      {error && (
        <p class="question__error" id={errorId}>
          <span class="visually-hidden">Erreur&nbsp;:</span> {error}
        </p>
      )}
      {question.type === 'short-text' ? (
        <input
          id={fieldId}
          name={question.id}
          type="text"
          value={value}
          maxlength={300}
          required={question.required}
          aria-describedby={describedBy}
          aria-invalid={invalid}
        />
      ) : (
        <textarea
          id={fieldId}
          name={question.id}
          rows="5"
          maxlength={3000}
          required={question.required}
          aria-describedby={describedBy}
          aria-invalid={invalid}
        >{value}</textarea>
      )}
    </div>
  )
}

{
  (question.type === 'single-choice' || question.type === 'multiple-choice') && (
    <fieldset
      class:list={['question', { 'question--invalid': error }]}
      aria-describedby={describedBy}
    >
      <legend class="question__label">
        {label}
        {requiredMark}
      </legend>
      {help && (
        <p class="question__help" id={helpId}>
          {help}
        </p>
      )}
      {error && (
        <p class="question__error" id={errorId}>
          <span class="visually-hidden">Erreur&nbsp;:</span> {error}
        </p>
      )}
      <div class="question__options">
        {question.options.map((option, index) => (
          <label class="option" for={`${fieldId}__${index}`}>
            <input
              id={`${fieldId}__${index}`}
              type={question.type === 'single-choice' ? 'radio' : 'checkbox'}
              name={question.id}
              value={option}
              checked={isChecked(option)}
              required={question.required && question.type === 'single-choice'}
              aria-invalid={invalid}
            />
            {frenchSpacing(option)}
          </label>
        ))}
      </div>
    </fieldset>
  )
}

{
  question.type === 'scale' && (
    <fieldset
      class:list={['question', { 'question--invalid': error }]}
      aria-describedby={describedBy}
    >
      <legend class="question__label">
        {label}
        {requiredMark}
      </legend>
      {help && (
        <p class="question__help" id={helpId}>
          {help}
        </p>
      )}
      {error && (
        <p class="question__error" id={errorId}>
          <span class="visually-hidden">Erreur&nbsp;:</span> {error}
        </p>
      )}
      <div class="question__scale">
        {scaleSteps.map(({ step, hint }) => (
          <label class="option option--scale" for={`${fieldId}__${step}`}>
            <input
              id={`${fieldId}__${step}`}
              type="radio"
              name={question.id}
              value={step}
              checked={value === String(step)}
              required={question.required}
              aria-invalid={invalid}
            />
            <span>
              {step}
              {hint && <span class="option__hint">{frenchSpacing(hint)}</span>}
            </span>
          </label>
        ))}
      </div>
    </fieldset>
  )
}

<style>
  .question {
    display: grid;
    gap: var(--space-2xs);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .question--invalid {
    padding-inline-start: var(--space-s);
    border-inline-start: 4px solid var(--color-danger);
  }

  .question__label {
    padding: 0;
    font-weight: var(--weight-semibold);
  }

  .question__help {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .question__error {
    color: var(--color-danger);
    font-weight: var(--weight-semibold);
  }

  .question input[type='text'],
  .question textarea {
    width: 100%;
    min-height: var(--tap-min);
    padding: var(--space-2xs) var(--space-xs);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-s);
    background-color: var(--color-bg);
  }

  .question__options {
    display: grid;
    gap: var(--space-3xs);
  }

  .option {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--tap-min);
    cursor: pointer;
  }

  .option input,
  .question input[type='text'],
  .question textarea {
    /* Keep the question and its error in view when an error summary link jumps here. */
    scroll-margin-block-start: 8rem;
  }

  .option input {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--color-primary);
  }

  .question__scale {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: var(--space-2xs);
    max-width: 32rem;
  }

  .option--scale {
    flex-direction: column;
    gap: var(--space-3xs);
    text-align: center;
  }

  .option--scale > span {
    display: grid;
  }

  .option__hint {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
</style>
