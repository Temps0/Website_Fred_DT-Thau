---
/**
 * Grey box standing for a future image, with a visible description of what goes there.
 */
interface Props {
  label: string;
  ratio?: 'landscape' | 'portrait' | 'square';
}

const { label, ratio = 'landscape' } = Astro.props;
---

<div class:list={['wire-placeholder', `wire-placeholder--${ratio}`]}>
  <span>{label}</span>
</div>

<style>
  .wire-placeholder {
    display: grid;
    place-items: center;
    padding: var(--space-s);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-m);
    background-color: var(--color-surface-strong);
    color: var(--color-text-muted);
    font-size: var(--step--1);
    text-align: center;
  }

  /* On a dark section, the muted text colour is light: keep the box dark too. */
  :global(.section--dark) .wire-placeholder {
    border-color: var(--color-on-dark-muted);
    background-color: transparent;
  }

  .wire-placeholder--landscape {
    aspect-ratio: 4 / 3;
  }

  .wire-placeholder--portrait {
    aspect-ratio: 4 / 5;
  }

  .wire-placeholder--square {
    aspect-ratio: 1;
  }
</style>
